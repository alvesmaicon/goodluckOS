#!/bin/sh
# Prints the translation of an English string for the configured language, or the string itself.
# Same files and setting as the apps (see rootfs/package/common/i18n.h):
#   gl-tr "Shutting down..."
code=$(sed -n 's/^language=//p' /home/player/.config/puppy/settings 2>/dev/null | tail -n 1)
file=/usr/share/goodluck/lang/$code.lang
text=""
if [ -n "$code" ] && [ "$code" != "en" ] && [ -f "$file" ]; then
    text=$(awk -v key="$1" 'index($0, key " = ") == 1 { print substr($0, length(key) + 4); exit }' "$file")
fi
printf '%s' "${text:-$1}"
