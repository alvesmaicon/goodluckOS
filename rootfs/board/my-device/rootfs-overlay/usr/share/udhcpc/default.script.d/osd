#!/bin/sh
# udhcpc hook: usb-net.sh checks the internet and shows the address the USB network got with the result
case "$1" in
    bound|renew)
        if command -v curl >/dev/null; then /usr/local/bin/usb-net.sh check >/dev/null 2>&1 &
        else /usr/local/bin/osd-notify.sh network "$ip"; fi
        ;;
    deconfig) rm -f /tmp/usb-net.check ;;
esac
exit 0
