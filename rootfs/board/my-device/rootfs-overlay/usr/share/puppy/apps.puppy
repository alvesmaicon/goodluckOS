MEDIA=1
Description=Videos and series
ENTRY_DIRECTORIES=/home/player/media/videos;/media/external/media/videos
ENTRY_EXTENSIONS=mp4;mkv;avi;webm;mov;m4v;mpg;mpeg;wmv;flv;3gp
ENTRY_ICONS_DIRECTORIES=/home/player/media/videos/icons;/media/external/media/videos/icons
DEFAULT_ICON=/usr/share/icons/videos.png
COMMAND=mpv %s
