ENTRY_ICONS_DIRECTORIES=/home/player/roms/snes/icons;/home/player/roms/sfc/icons;/media/external/roms/snes/icons;/media/external/roms/sfc/icons
DEFAULT_ICON=/usr/share/icons/snes.png
COMMAND=retroarch -L /usr/lib/libretro/snes9x2005_libretro.so %s

