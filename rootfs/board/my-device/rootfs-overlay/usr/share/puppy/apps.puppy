[ENTRY]
CATEGORY=System
NAME=Reboot
DESCRIPTION=Reboot the device
COMMAND=are-you-sure "Are you sure you want to reboot the device?" "doas /sbin/reboot" "Restarting..."
ICON=/usr/share/icons/reboot.png

[ENTRY]
CATEGORY=System
NAME=Power Off
DESCRIPTION=Power off the device
COMMAND=are-you-sure "Are you sure you want to power off the device?" "doas /sbin/poweroff" "Shutting down..."
ICON=/usr/share/icons/poweroff.png

[ENTRY]
CATEGORY=System
NAME=System Settings
DESCRIPTION=Modify your system's settings
COMMAND=system-settings
ICON=/usr/share/icons/system-settings.png

[ENTRY]
CATEGORY=System
NAME=Resize Home
DESCRIPTION=Resize your HOME partition (also in System Settings)
COMMAND=resize-home
ICON=/usr/share/icons/resize-home.png
HIDE_IF_EXISTS=/etc/player-flags/.home_resize_status

[ENTRY]
CATEGORY=Emulators/Frontends
NAME=RetroArch
Description=A frontend for emulators, game engines and media players
COMMAND=retroarch
ICON=/usr/share/icons/retroarch.png

[ENTRY]
CATEGORY=Games
NAME=Chocolate Doom
DESCRIPTION=It's Doom.
ICON=/usr/share/icons/chocolate-doom.png
COMMAND=chocolate-doom

[ARCHIVE]
NAME=Playstation
TAB=PS1
Description=Sony Playstation
ENTRY_DIRECTORIES=/home/player/roms/psx
ENTRY_EXTENSIONS=bin;cue;chd;m3u;iso
ENTRY_ICONS_DIRECTORIES=/home/player/roms/psx/icons
DEFAULT_ICON=/usr/share/icons/psx.png
COMMAND=retroarch -L /usr/lib/libretro/pcsx_rearmed_libretro.so %s

[ARCHIVE]
NAME=Game Boy (Color)
TAB=GB/GBC
Description=Game Boy / Game Boy Color
ENTRY_DIRECTORIES=/home/player/roms/gb;/home/player/roms/gbc
ENTRY_EXTENSIONS=gb;gbc;zip;7z
ENTRY_ICONS_DIRECTORIES=/home/player/roms/gb/icons;/home/player/roms/gbc/icons
DEFAULT_ICON=/usr/share/icons/gbc.png
COMMAND=retroarch -L /usr/lib/libretro/gambatte_libretro.so %s

[ARCHIVE]
NAME=Super Nintendo
TAB=SNES
Description=SNES (Super Nintendo Entertainment System)
ENTRY_DIRECTORIES=/home/player/roms/snes;/home/player/roms/sfc
ENTRY_EXTENSIONS=sfc;smc;zip;7z
ENTRY_ICONS_DIRECTORIES=/home/player/roms/snes/icons;/home/player/roms/sfc/icons
DEFAULT_ICON=/usr/share/icons/snes.png
COMMAND=retroarch -L /usr/lib/libretro/snes9x2005_libretro.so %s

[ARCHIVE]
NAME=Game Boy Advance
TAB=GBA
Description=GBA (Game Boy Advance)
ENTRY_DIRECTORIES=/home/player/roms/gba
ENTRY_EXTENSIONS=gba;zip;7z
ENTRY_ICONS_DIRECTORIES=/home/player/roms/gba/icons
DEFAULT_ICON=/usr/share/icons/gba.png
COMMAND=retroarch -L /usr/lib/libretro/mgba_libretro.so %s

[ARCHIVE]
NAME=Nintendo Entertainment System
TAB=NES
Description=NES (Nintendo Entertainment System)
ENTRY_DIRECTORIES=/home/player/roms/nes;/home/player/roms/famicom
ENTRY_EXTENSIONS=nes;fds;unf;unif;zip;7z
ENTRY_ICONS_DIRECTORIES=/home/player/roms/nes/icons;/home/player/roms/famicom/icons
DEFAULT_ICON=/usr/share/icons/nes.png
COMMAND=retroarch -L /usr/lib/libretro/fceumm_libretro.so %s

[ARCHIVE]
NAME=DOSBox
TAB=DOS
Description=DOS
ENTRY_DIRECTORIES=/home/player/roms/dos
ENTRY_EXTENSIONS=exe;com;bat;conf;
ENTRY_ICONS_DIRECTORIES=/home/player/roms/dos/icons
DEFAULT_ICON=/usr/share/icons/dos.png
COMMAND=retroarch -L /usr/lib/libretro/dosbox_libretro.so %s

[ARCHIVE]
NAME=PSP
TAB=PSP
Description=PSP (Playstation Portable)
ENTRY_DIRECTORIES=/home/player/roms/psp
ENTRY_EXTENSIONS=iso;cso;chd
ENTRY_ICONS_DIRECTORIES=/home/player/roms/psp/icons
DEFAULT_ICON=/usr/share/icons/psp.png
COMMAND=retroarch -L /usr/lib/libretro/ppsspp_libretro.so %s

[ARCHIVE]
NAME=Sega Genesis
TAB=Genesis
Description=Sega Genesis / Mega Drive
ENTRY_DIRECTORIES=/home/player/roms/genesis;/home/player/roms/megadrive
ENTRY_EXTENSIONS=md;smd;gen;bin;zip;7z
ENTRY_ICONS_DIRECTORIES=/home/player/roms/genesis/icons;/home/player/roms/megadrive/icons
DEFAULT_ICON=/usr/share/icons/genesis.png
COMMAND=retroarch -L /usr/lib/libretro/genesis_plus_gx_libretro.so %s

[ARCHIVE]
NAME=Sega Master System
TAB=SMS
Description=Sega Master System (SMS)
ENTRY_DIRECTORIES=/home/player/roms/sms;/home/player/roms/mastersystem
ENTRY_EXTENSIONS=sms;zip;7z
ENTRY_ICONS_DIRECTORIES=/home/player/roms/sms/icons;/home/player/roms/mastersystem/icons
DEFAULT_ICON=/usr/share/icons/sms.png
COMMAND=retroarch -L /usr/lib/libretro/genesis_plus_gx_libretro.so %s

[ARCHIVE]
NAME=Sega Game Gear
TAB=Game Gear
Description=Sega Game Gear (GG)
ENTRY_DIRECTORIES=/home/player/roms/gg;/home/player/roms/gamegear
ENTRY_EXTENSIONS=gg;zip;7z
ENTRY_ICONS_DIRECTORIES=/home/player/roms/gg/icons;/home/player/roms/gamegear/icons
DEFAULT_ICON=/usr/share/icons/gg.png
COMMAND=retroarch -L /usr/lib/libretro/genesis_plus_gx_libretro.so %s

[ARCHIVE]
NAME=Sega CD
TAB=Sega CD
Description=Sega CD / Mega CD
ENTRY_DIRECTORIES=/home/player/roms/segacd
ENTRY_EXTENSIONS=cue;chd;iso
ENTRY_ICONS_DIRECTORIES=/home/player/roms/segacd/icons
DEFAULT_ICON=/usr/share/icons/segacd.png
COMMAND=retroarch -L /usr/lib/libretro/genesis_plus_gx_libretro.so %s

[ARCHIVE]
NAME=Doom
TAB=Doom
Description=Doom WADs
ENTRY_DIRECTORIES=/home/player/roms/doom
ENTRY_EXTENSIONS=wad;iwad;
ENTRY_ICONS_DIRECTORIES=/home/player/roms/doom/icons
DEFAULT_ICON=/usr/share/icons/chocolate-doom.png
COMMAND=chocolate-doom -iwad %s

[ARCHIVE]
NAME=Music
TAB=Music
MEDIA=1
Description=Songs and albums
ENTRY_DIRECTORIES=/home/player/media/music
ENTRY_EXTENSIONS=mp3;flac;ogg;opus;m4a;aac;wav;wma
ENTRY_ICONS_DIRECTORIES=/home/player/media/music/icons
DEFAULT_ICON=/usr/share/icons/music.png
COMMAND=mpv %s

[ARCHIVE]
NAME=Videos
TAB=Videos
MEDIA=1
Description=Videos and series
ENTRY_DIRECTORIES=/home/player/media/videos
ENTRY_EXTENSIONS=mp4;mkv;avi;webm;mov;m4v;mpg;mpeg;wmv;flv;3gp
ENTRY_ICONS_DIRECTORIES=/home/player/media/videos/icons
DEFAULT_ICON=/usr/share/icons/videos.png
COMMAND=mpv %s
