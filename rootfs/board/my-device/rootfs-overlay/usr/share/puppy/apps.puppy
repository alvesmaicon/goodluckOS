[ENTRY]
CATEGORY=System
NAME=Reboot
DESCRIPTION=Reboot the device
COMMAND=are-you-sure "Are you sure you want to reboot the device?" "doas /sbin/reboot" "Restarting..."
ICON=/usr/share/icons/reboot.png

[ENTRY]
CATEGORY=System
NAME=Power Off
DESCRIPTION=Power off the device
COMMAND=are-you-sure "Are you sure you want to power off the device?" "doas /sbin/poweroff" "Shutting down..."
ICON=/usr/share/icons/poweroff.png

[ENTRY]
CATEGORY=System
NAME=System Settings
DESCRIPTION=Modify your system's settings
COMMAND=system-settings
ICON=/usr/share/icons/system-settings.png

[ENTRY]
CATEGORY=System
NAME=Resize Home
DESCRIPTION=Resize your HOME partition (also in System Settings)
COMMAND=resize-home
ICON=/usr/share/icons/resize-home.png
HIDE_IF_EXISTS=/etc/player-flags/.home_resize_status

[ENTRY]
CATEGORY=Terminal
NAME=Last App Log
DESCRIPTION=View the console logs of the last app
TERMINAL=1
COMMAND=doas evsieve --input /dev/input/event2 grab --map btn:dpad_up key:up --map btn:dpad_down key:down --output repeat=enable & less /dev/shm/application/application.log

[ENTRY]
CATEGORY=Terminal
NAME=Process Viewer
DESCRIPTION=View the running processes with Top
TERMINAL=1
COMMAND=doas evsieve --input /dev/input/event2 grab --map btn:dpad_up key:up --map btn:dpad_down key:down --map btn:dpad_left key:pageup --map btn:dpad_right key:pagedown --map btn:south key:q --output repeat=enable & top

[ENTRY]
CATEGORY=Terminal
NAME=AlsaMixer
DESCRIPTION=View and Modify your sound settings
TERMINAL=1
COMMAND=doas evsieve --input /dev/input/event2 grab --map btn:dpad_up key:up --map btn:dpad_down key:down --map btn:dpad_right key:right --map btn:dpad_left key:left --map btn:south key:esc --output repeat=enable & alsamixer

[ENTRY]
CATEGORY=Terminal
NAME=Dmesg
DESCRIPTION=View kernel logs
TERMINAL=1
COMMAND=doas evsieve --input /dev/input/event2 grab --map btn:dpad_up key:up --map btn:dpad_down key:down --map btn:dpad_left key:pageup --map btn:dpad_right key:pagedown --map btn:south key:q --output repeat=enable & sed -E 's/^.{16}//' /var/log/messages | less -m

[ENTRY]
CATEGORY=Emulators/Frontends
NAME=RetroArch
Description=A frontend for emulators, game engines and media players
COMMAND=retroarch
ICON=/usr/share/icons/retroarch.png

[ENTRY]
CATEGORY=Games
NAME=Chocolate Doom
DESCRIPTION=It's Doom.
ICON=/usr/share/icons/chocolate-doom.png
COMMAND=chocolate-doom

[ARCHIVE]
NAME=Playstation
TAB=PS1
Description=Sony Playstation
ENTRY_DIRECTORIES=/home/player/roms/psx;/media/external/roms/psx
ENTRY_EXTENSIONS=bin;cue;chd;m3u;iso
ENTRY_ICONS_DIRECTORIES=/home/player/roms/psx/icons;/media/external/roms/psx/icons
DEFAULT_ICON=/usr/share/icons/psx.png
COMMAND=retroarch -L /usr/lib/libretro/pcsx_rearmed_libretro.so %s

[ARCHIVE]
NAME=Game Boy (Color)
TAB=GB/GBC
Description=Game Boy / Game Boy Color
ENTRY_DIRECTORIES=/home/player/roms/gb;/home/player/roms/gbc;/media/external/roms/gb;/media/external/roms/gbc
ENTRY_EXTENSIONS=gb;gbc;zip;7z
ENTRY_ICONS_DIRECTORIES=/home/player/roms/gb/icons;/home/player/roms/gbc/icons;/media/external/roms/gb/icons;/media/external/roms/gbc/icons
DEFAULT_ICON=/usr/share/icons/gbc.png
COMMAND=retroarch -L /usr/lib/libretro/gambatte_libretro.so %s

[ARCHIVE]
NAME=Super Nintendo
TAB=SNES
Description=SNES (Super Nintendo Entertainment System)
