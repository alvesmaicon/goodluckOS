COMMAND=chocolate-doom -iwad %s

[ARCHIVE]
NAME=Music
TAB=Music
MEDIA=1
Description=Songs and albums
ENTRY_DIRECTORIES=/home/player/media/music;/media/external/media/music
ENTRY_EXTENSIONS=mp3;flac;ogg;opus;m4a;aac;wav;wma
ENTRY_ICONS_DIRECTORIES=/home/player/media/music/icons;/media/external/media/music/icons
DEFAULT_ICON=/usr/share/icons/music.png
COMMAND=mpv %s

[ARCHIVE]
NAME=Videos
