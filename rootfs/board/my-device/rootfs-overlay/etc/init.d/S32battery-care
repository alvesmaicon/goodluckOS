#!/bin/sh
# Stop charging at 90 % while on a computer's USB, warn when the battery runs low and power off before it's empty

case "$1" in
    start)
        /usr/local/bin/battery-care.sh </dev/null >/dev/null 2>&1 &
        ;;
    stop)
        kill $(ps | grep '[b]attery-care.sh' | awk '{ print $1 }') 2>/dev/null
        # the PMIC keeps the setting while off: leave the charger on for the next charge
        for b in /sys/class/power_supply/*; do [ "$(cat $b/type 2>/dev/null)" = Battery ] && echo Charging > $b/status; done
        ;;
esac
exit 0
