#!/bin/sh
# Power cut log for alvesmaicon/goodluckOS#8, only when /etc/player-flags/blackbox exists

case "$1" in
    start)
        [ -f /etc/player-flags/blackbox ] || exit 0
        /usr/local/bin/blackbox.sh "$(cat /etc/player-flags/blackbox)" </dev/null >/dev/null 2>&1 &
        ;;
    stop)
        kill $(ps | grep '[b]lackbox.sh' | awk '{ print $1 }') 2>/dev/null
        ;;
esac
exit 0
