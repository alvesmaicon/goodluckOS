#!/bin/sh
# Silent boot: stop kernel messages on the console and clear the screen before the launcher starts.
# A centred "Starting system..." (translated by gl-tr) fills the few seconds until Puppy draws its
# first frame (the console is 80x30 characters: 640x480 with the 8x16 font).
[ "$1" = "stop" ] && exit 0
dmesg -n 1
msg=$(/usr/local/bin/gl-tr "Starting system...")
printf "\033[2J\033[H\033[?25l\033[15;%dH%s" $(( (80 - ${#msg}) / 2 + 1 )) "$msg" > /dev/tty1 2>/dev/null
exit 0
