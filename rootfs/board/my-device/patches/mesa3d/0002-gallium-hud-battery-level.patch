From: Maicon Alves <alvesmaiconn@gmail.com>
Subject: [PATCH] gallium/hud: goodluckOS battery level

Shows the battery level and state in the top right corner of any app,
when GALLIUM_HUD_STATUS lists "battery". Goes on top of the feedback
panel (0001).

---
--- a/src/gallium/auxiliary/hud/hud_context.c
+++ b/src/gallium/auxiliary/hud/hud_context.c
@@ -69,6 +69,7 @@
 #include "tgsi/tgsi_text.h"
 #include "tgsi/tgsi_dump.h"
 #include "util/os_time.h"
+#include <dirent.h>
 #include <sys/stat.h>
 
 #define HUD_DEFAULT_VISIBILITY true
@@ -82,9 +83,10 @@
 static int hud_rotate = HUD_DEFAULT_ROTATION;
 static float hud_opacity = HUD_DEFAULT_OPACITY / 100.0f;
 
-/* goodluckOS: a feedback panel, drawn over any app even with the graphs
- * hidden. osd-notify.sh writes the panel's title and text to /dev/shm/hud-osd
- * (GALLIUM_HUD_FEEDBACK=false turns it off). */
+/* goodluckOS: a feedback panel and the battery level, drawn over any app even
+ * with the graphs hidden. osd-notify.sh writes the panel's title and text to
+ * /dev/shm/hud-osd (GALLIUM_HUD_FEEDBACK=false turns it off), and
+ * GALLIUM_HUD_STATUS=battery shows the battery in the top right corner. */
 #define OSD_FILE "/dev/shm/hud-osd"
 #define OSD_MS 1500
 #define OSD_PAD 12
@@ -100,6 +102,14 @@
    int64_t next_ms, until_ms;
    char title[64], text[64];
 } osd = { .enabled = -1 };
+
+static struct {
+   int enabled;
+   int64_t next_ms;
+   char dir[300];
+   int percent;
+   bool charging, full;
+} battery = { .enabled = -1, .percent = -1 };
 
 #define MAX_QUADS 16
 static struct {
@@ -108,6 +118,10 @@
 } quads[MAX_QUADS];
 static unsigned num_quads;
 
+static const float kWhite[] = {1, 1, 1, 1};
+static const float kYellow[] = {1, 205 / 255.0, 60 / 255.0, 1};
+static const float kRed[] = {230 / 255.0, 60 / 255.0, 50 / 255.0, 1};
+static const float kGreen[] = {80 / 255.0, 200 / 255.0, 90 / 255.0, 1};
 static const float kShade[] = {12 / 255.0, 12 / 255.0, 14 / 255.0, 0.5};
 
 #if DETECT_OS_POSIX
@@ -532,6 +546,21 @@
    return strlen(str) * (unsigned)(hud->font.glyph_width * text_scale);
 }
 
+static bool
+read_line(const char *path, char *buf, size_t size)
+{
+   FILE *f = fopen(path, "r");
+   bool ok;
+
+   if (!f)
+      return false;
+   ok = fgets(buf, size, f) != NULL;
+   fclose(f);
+   if (ok)
+      buf[strcspn(buf, "\n")] = 0;
+   return ok;
+}
+
 /* checked every 100 ms; a panel written before the app started isn't shown */
 static void
 hud_osd_update(int64_t now)
@@ -562,6 +591,74 @@
       }
    }
    osd.visible = now < osd.until_ms;
+}
+
+/* the first power supply of type Battery, read every 5 s */
+static void
+hud_battery_update(int64_t now)
+{
+   char buf[32], path[320];
+
+   if (battery.enabled < 0) {
+      const char *env = getenv("GALLIUM_HUD_STATUS");
+      battery.enabled = env && strstr(env, "battery");
+   }
+   if (!battery.enabled || now < battery.next_ms)
+      return;
+   battery.next_ms = now + 5000;
+
+   if (!battery.dir[0]) {
+      DIR *dir = opendir("/sys/class/power_supply");
+      struct dirent *e;
+
+      while (dir && (e = readdir(dir))) {
+         snprintf(path, sizeof(path), "/sys/class/power_supply/%s/type", e->d_name);
+         if (read_line(path, buf, sizeof(buf)) && !strcmp(buf, "Battery")) {
+            snprintf(battery.dir, sizeof(battery.dir), "/sys/class/power_supply/%s", e->d_name);
+            break;
+         }
+      }
+      if (dir)
+         closedir(dir);
+      if (!battery.dir[0]) {
+         battery.enabled = 0;
+         return;
+      }
+   }
+   snprintf(path, sizeof(path), "%s/capacity", battery.dir);
+   battery.percent = read_line(path, buf, sizeof(buf)) ? atoi(buf) : -1;
+   snprintf(path, sizeof(path), "%s/status", battery.dir);
+   if (read_line(path, buf, sizeof(buf))) {
+      battery.charging = !strcmp(buf, "Charging");
+      battery.full = !strcmp(buf, "Full");
+   }
+}
+
+/* the battery in the top right corner; returns its bottom */
+static unsigned
+hud_battery_accumulate(struct hud_context *hud)
+{
+   char text[16] = "??";
+   unsigned th = hud->font.glyph_height * text_scale;
+   unsigned h = MAX2(th, 12) + 8, x, y = 6;
+   const float *fill = battery.full || (battery.charging && battery.percent >= 100) ? kGreen :
+                       battery.charging ? kYellow : battery.percent <= 10 ? kRed : kWhite;
+
+   if (battery.percent >= 0)
+      snprintf(text, sizeof(text), "%d%%", battery.percent);
+   x = hud->fb_width - 8 - (8 + 30 + hud_text_width(hud, text) + 8);
+   hud_quad(x, y, 8 + 30 + hud_text_width(hud, text) + 8, h, kShade);
+   hud_draw_string(hud, x + 8 + 30, y + (h - th) / 2, "%s", text);
+   x += 8;
+   y += (h - 12) / 2;
+   hud_quad(x, y, 22, 1, kWhite);
+   hud_quad(x, y + 11, 22, 1, kWhite);
+   hud_quad(x, y, 1, 12, kWhite);
+   hud_quad(x + 21, y, 1, 12, kWhite);
+   hud_quad(x + 22, y + 3, 2, 6, kWhite);
+   if (battery.percent > 0)
+      hud_quad(x + 2, y + 2, MAX2(18 * MIN2(battery.percent, 100) / 100, 3), 8, fill);
+   return 6 + h;
 }
 
 /* the panel, centred: the title in bold over the text */
@@ -587,11 +684,14 @@
 
    num_quads = 0;
    hud_osd_update(now);
+   hud_battery_update(now);
    if (!hud->fb_width)
       return;
 
    text_scale = TEXT_SCALE;
    text_background = false;
+   if (battery.enabled)
+      y = hud_battery_accumulate(hud) + 8;
    if (osd.visible)
       hud_osd_accumulate(hud, y);
    text_scale = 1;
