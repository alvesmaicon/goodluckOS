@@ -485,6 +541,319 @@
  * The texture is usually the back buffer being displayed.
  */
 static void
+hud_quad(unsigned x1, unsigned y1, unsigned w, unsigned h, const float *color)
+{
+   if (num_quads == MAX_QUADS)
+      return;
+   quads[num_quads].x1 = x1;
+   quads[num_quads].y1 = y1;
+   quads[num_quads].x2 = x1 + w;
+   quads[num_quads].y2 = y1 + h;
+   memcpy(quads[num_quads].color, color, sizeof(quads[0].color));
+   num_quads++;
+}
+
+static unsigned
+hud_text_width(struct hud_context *hud, const char *str)
+{
+   return strlen(str) * (unsigned)(hud->font.glyph_width * text_scale);
+}
+
+static unsigned
+hud_text_height(struct hud_context *hud)
+{
+   return hud->font.glyph_height * text_scale;
+}
+
+static void
+hud_colored_string(struct hud_context *hud, unsigned x, unsigned y,
+                   const float *color, const char *str)
+{
+   unsigned first = hud->text.num_vertices;
+
+   hud_draw_string(hud, x, y, "%s", str);
+   if (num_text_colors == MAX_TEXT_COLORS || hud->text.num_vertices == first)
+      return;
+   text_colors[num_text_colors].first = first;
+   text_colors[num_text_colors].count = hud->text.num_vertices - first;
+   memcpy(text_colors[num_text_colors].color, color, sizeof(text_colors[0].color));
+   num_text_colors++;
+}
+
+static bool
+read_line(const char *path, char *buf, size_t size)
+{
+   FILE *f = fopen(path, "r");
+   bool ok;
+
+   if (!f)
+      return false;
+   ok = fgets(buf, size, f) != NULL;
+   fclose(f);
+   if (ok)
+      buf[strcspn(buf, "\n")] = 0;
+   return ok;
+}
+
+static bool
+file_changed(const char *path, struct timespec *mtime)
+{
+   struct stat st;
+
+   if (stat(path, &st) != 0 ||
+       (st.st_mtim.tv_sec == mtime->tv_sec && st.st_mtim.tv_nsec == mtime->tv_nsec))
+      return false;
+   *mtime = st.st_mtim;
+   return true;
+}
+
+static void
+hud_osd_update(int64_t now)
+{
+   if (file_changed(OSD_FILE, &osd.mtime)) {
+      char lines[3][64] = {{0}};
+      FILE *f = fopen(OSD_FILE, "r");
+
+      if (f) {
+         for (int i = 0; i < 3 && fgets(lines[i], sizeof(lines[i]), f); i++)
+            lines[i][strcspn(lines[i], "\n")] = 0;
+         fclose(f);
+         snprintf(osd.label, sizeof(osd.label), "%s", lines[0]);
+         snprintf(osd.value, sizeof(osd.value), "%s", lines[1]);
+         osd.percent = lines[2][0] ? atoi(lines[2]) : -1;
+         /* a notification older than the app isn't shown */
+         if (osd.started)
+            osd.until_ms = now + OSD_MS;
+      }
+   }
+   osd.started = true;
+   osd.visible = now < osd.until_ms;
+}
+
+static void
+hud_status_update(int64_t now)
+{
+   char buf[64];
+
+   if (status.enabled < 0) {
+      const char *env = getenv("GALLIUM_HUD_STATUS");
+      status.enabled = env && strcmp(env, "0") && strcmp(env, "false");
+   }
+   if (!status.enabled)
+      return;
+
+   if (file_changed(STATUS_FILE, &status.mtime) && read_line(STATUS_FILE, buf, sizeof(buf))) {
+      int muted = 0, headphones = 0;
+      if (sscanf(buf, "%d %d %d", &status.volume, &muted, &headphones) == 3) {
+         status.muted = muted;
+         status.headphones = headphones;
+      }
+   }
+
+   if (now < status.next_ms)
+      return;
+   status.next_ms = now + 5000;
+
+   if (!status.battery_dir[0]) {
+      DIR *dir = opendir("/sys/class/power_supply");
+      struct dirent *e;
+
+      while (dir && (e = readdir(dir))) {
+         char path[300];
+         snprintf(path, sizeof(path), "/sys/class/power_supply/%s/type", e->d_name);
+         if (read_line(path, buf, sizeof(buf)) && !strcmp(buf, "Battery")) {
+            snprintf(status.battery_dir, sizeof(status.battery_dir),
+                     "/sys/class/power_supply/%s", e->d_name);
+            break;
+         }
+      }
+      if (dir)
+         closedir(dir);
+      if (!status.battery_dir[0])
+         return;
+   }
+
+   char path[320];
+   snprintf(path, sizeof(path), "%s/capacity", status.battery_dir);
+   status.battery = read_line(path, buf, sizeof(buf)) ? atoi(buf) : -1;
+   snprintf(path, sizeof(path), "%s/status", status.battery_dir);
+   if (read_line(path, buf, sizeof(buf))) {
+      status.charging = !strcmp(buf, "Charging");
+      status.full = !strcmp(buf, "Full");
+   }
+}
+
+/* the launcher's icons: speaker and headphones 16x16, battery 24x12 */
+static void
+speaker_icon(unsigned x, unsigned y, const float *c, bool muted)
+{
+   hud_quad(x, y + 5, 4, 6, c);
+   for (unsigned i = 0; i < 6; i++)
+      hud_quad(x + 4 + i, y + 5 - i, 1, 6 + 2 * i, c);
+   if (muted) {
+      for (unsigned i = 0; i < 8; i++) {
+         hud_quad(x + 11 + i * 5 / 7, y + 4 + i, 2, 1, c);
+         hud_quad(x + 11 + i * 5 / 7, y + 11 - i, 2, 1, c);
+      }
+   } else {
+      hud_quad(x + 12, y + 5, 1, 6, c);
+      hud_quad(x + 14, y + 3, 1, 10, c);
+   }
+}
+
+static void
+headphones_icon(unsigned x, unsigned y, const float *c)
+{
+   hud_quad(x + 4, y, 8, 2, c);
+   hud_quad(x + 2, y + 1, 2, 2, c);
+   hud_quad(x + 12, y + 1, 2, 2, c);
+   hud_quad(x, y + 3, 2, 7, c);
+   hud_quad(x + 14, y + 3, 2, 7, c);
+   hud_quad(x, y + 9, 4, 7, c);
+   hud_quad(x + 12, y + 9, 4, 7, c);
+}
+
+static void
+battery_icon(unsigned x, unsigned y, int percent, bool charging, bool full)
+{
+   const float *c = full || (charging && percent >= 100) ? kGreen :
+                    charging ? kYellow : percent <= 10 ? kRed : kGrey;
+
+   hud_quad(x, y, 22, 1, kGrey);
+   hud_quad(x, y + 11, 22, 1, kGrey);
+   hud_quad(x, y, 1, 12, kGrey);
+   hud_quad(x + 21, y, 1, 12, kGrey);
+   hud_quad(x + 22, y + 3, 2, 6, kGrey);
+   if (percent > 0) {
+      unsigned w = 18 * (percent > 100 ? 100 : percent) / 100;
+      hud_quad(x + 2, y + 2, w < 3 ? 3 : w, 8, c);
+   }
+}
+
+static void
+hud_osd_accumulate(struct hud_context *hud)
+{
+   unsigned th = hud_text_height(hud);
+   unsigned h = 10 + th + 31;
+   unsigned x = (hud->fb_width > OSD_W ? hud->fb_width - OSD_W : 0) / 2;
+   unsigned y = status.enabled ? 6 + (th > 16 ? th : 16) + 8 + 8 : 24;   /* below the status bar */
+   unsigned w = hud_text_width(hud, osd.value);
+
+   hud_quad(x, y, OSD_W, h, kTile);
+   hud_quad(x + 2, y + 2, OSD_W - 4, h - 4, kPanel);
+   hud_colored_string(hud, x + OSD_PAD, y + 10, kWhite, osd.label);
+   if (osd.percent >= 0) {
+      unsigned tw = OSD_W - 2 * OSD_PAD;
+      unsigned pct = osd.percent > 100 ? 100 : osd.percent;
+
+      hud_colored_string(hud, x + OSD_W - OSD_PAD - w, y + 10, kYellow, osd.value);
+      hud_quad(x + OSD_PAD, y + h - 20, tw, 8, kTile);
+      if (pct)
+         hud_quad(x + OSD_PAD, y + h - 20, tw * pct / 100, 8, kYellow);
+   } else {
+      hud_colored_string(hud, x + (OSD_W - w) / 2, y + h - 10 - th, kYellow, osd.value);
+   }
+}
+
+static void
+hud_status_accumulate(struct hud_context *hud)
+{
+   char bat[16], vol[16];
+   unsigned th = hud_text_height(hud);
+   unsigned bh = (th > 16 ? th : 16) + 8;
+   unsigned y = 6, x;
+   unsigned bat_w, vol_w = 0, total;
+
+   snprintf(bat, sizeof(bat), status.battery >= 0 ? "%d%%" : "??", status.battery);
+   bat_w = hud_text_width(hud, bat);
+   total = 8 + 28 + bat_w + 8;
+   if (status.volume >= 0) {
+      snprintf(vol, sizeof(vol), status.muted ? "mute" : "%d%%", status.volume);
+      vol_w = hud_text_width(hud, vol);
+      total += 22 + vol_w + 14;
+   }
+   x = hud->fb_width - 8 - total;
+
+   hud_quad(x, y, total, bh, kPanel);
+   x += 8;
+   if (status.volume >= 0) {
+      if (status.headphones)
+         headphones_icon(x, y + (bh - 16) / 2, kGrey);
+      else
+         speaker_icon(x, y + (bh - 16) / 2, kGrey, status.muted);
+      x += 22;
+      hud_colored_string(hud, x, y + (bh - th) / 2, kGrey, vol);
+      x += vol_w + 14;
+   }
+   battery_icon(x, y + (bh - 12) / 2, status.battery, status.charging, status.full);
+   x += 28;
+   hud_colored_string(hud, x, y + (bh - th) / 2, kGrey, bat);
+}
+
+static void
+hud_goodluck_accumulate(struct hud_context *hud)
+{
+   int64_t now = os_time_get_nano() / 1000000;
+   const char *env = getenv("GALLIUM_HUD_TEXT_SCALE");
+
+   num_quads = 0;
+   num_text_colors = 0;
+   hud_osd_update(now);
+   hud_status_update(now);
+   if (!hud->fb_width)
+      return;
+
+   text_scale = env ? atof(env) : 1.5;
+   if (status.enabled)
+      hud_status_accumulate(hud);
+   if (osd.visible)
+      hud_osd_accumulate(hud);
+   text_scale = 1;
+}
+
+static void
+hud_draw_quads(struct hud_context *hud)
+{
+   float buffer[MAX_QUADS * 8];
+
+   for (unsigned i = 0; i < num_quads;) {
+      unsigned n = 0, j = i;
+
+      for (; j < num_quads && !memcmp(quads[j].color, quads[i].color, sizeof(quads[i].color)); j++) {
+         float v[] = {
+            quads[j].x1, quads[j].y1, quads[j].x1, quads[j].y2,
+            quads[j].x2, quads[j].y2, quads[j].x2, quads[j].y1,
+         };
+         memcpy(buffer + n * 8, v, sizeof(v));
+         n++;
+      }
+      hud_draw_colored_prims(hud, MESA_PRIM_QUADS, buffer, n * 4, quads[i].color[0],
+                             quads[i].color[1], quads[i].color[2], quads[i].color[3], 0, 0, 1);
+      i = j;
+   }
+}
+
+static void
+hud_draw_text_range(struct hud_context *hud, unsigned first, unsigned count,
+                    const float *color, struct pipe_resource **releasebuf)
+{
+   if (!count)
+      return;
+   hud->constants.color[0] = color[0];
+   hud->constants.color[1] = color[1];
+   hud->constants.color[2] = color[2];
+   hud->constants.color[3] = 1;
+   hud->constants.translate[0] = 0;
+   hud->constants.translate[1] = 0;
+   hud->constants.scale[0] = hud_scale;
+   hud->constants.scale[1] = hud_scale;
+   pipe_resource_release(hud->pipe, *releasebuf);
+   *releasebuf = NULL;
+   pipe_upload_constant_buffer0(hud->pipe, MESA_SHADER_VERTEX, &hud->constbuf, releasebuf);
+   cso_draw_arrays(hud->cso, MESA_PRIM_QUADS, first, count);
+}
+
