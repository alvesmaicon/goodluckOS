+++ b/src/gallium/auxiliary/hud/hud_context.c	2026-10-02 18:26:08.651631720 -0300
@@ -68,6 +68,9 @@
 #include "util/u_upload_mgr.h"
 #include "tgsi/tgsi_text.h"
 #include "tgsi/tgsi_dump.h"
+#include "util/os_time.h"
+#include <dirent.h>
+#include <sys/stat.h>
 
 #define HUD_DEFAULT_VISIBILITY true
 #define HUD_DEFAULT_SCALE 1
@@ -80,6 +83,57 @@
 static int hud_rotate = HUD_DEFAULT_ROTATION;
 static float hud_opacity = HUD_DEFAULT_OPACITY / 100.0f;
 
+/* goodluckOS: a feedback panel (volume, brightness, audio output) and a status
+ * bar (battery, volume, output) drawn over any app, even with the graphs
+ * hidden. osd-notify.sh writes the panel as three lines (label, value, bar
+ * percent or -1) and hud-status.sh the volume, mute and headphones state. */
+#define OSD_FILE "/dev/shm/hud-osd"
+#define STATUS_FILE "/dev/shm/hud-status"
+#define OSD_MS 1500
+#define OSD_W 300
+#define OSD_PAD 14
+
+static float text_scale = 1;
+
+static struct {
+   bool started, visible;
+   struct timespec mtime;
+   int64_t until_ms;
+   char label[64], value[64];
+   int percent;
+} osd;
+
+static struct {
+   int enabled;
+   struct timespec mtime;
+   int64_t next_ms;
+   char battery_dir[300];
+   int battery, volume;
+   bool charging, full, muted, headphones;
+} status = { .enabled = -1, .battery = -1, .volume = -1 };
+
+#define MAX_QUADS 96
+static struct {
+   unsigned x1, y1, x2, y2;
+   float color[4];
+} quads[MAX_QUADS];
+static unsigned num_quads;
+
+#define MAX_TEXT_COLORS 8
+static struct {
+   unsigned first, count;
+   float color[3];
+} text_colors[MAX_TEXT_COLORS];
+static unsigned num_text_colors;
+
+static const float kWhite[] = {1, 1, 1, 1};
+static const float kGrey[] = {170 / 255.0, 170 / 255.0, 170 / 255.0, 1};
+static const float kYellow[] = {1, 205 / 255.0, 60 / 255.0, 1};
+static const float kRed[] = {230 / 255.0, 60 / 255.0, 50 / 255.0, 1};
+static const float kGreen[] = {80 / 255.0, 200 / 255.0, 90 / 255.0, 1};
+static const float kTile[] = {40 / 255.0, 40 / 255.0, 44 / 255.0, 1};
+static const float kPanel[] = {12 / 255.0, 12 / 255.0, 14 / 255.0, 235 / 255.0};
+
 #if DETECT_OS_POSIX
 static void
 signal_visible_handler(int sig, siginfo_t *siginfo, void *context)
