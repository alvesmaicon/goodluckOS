From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Maicon Alves <alvesmaiconn@gmail.com>
Date: Tue, 13 Oct 2026 02:49:42 -0300
Subject: [PATCH 05/13] OpenGL: create index buffers on GL_ELEMENT_ARRAY_BUFFER

Every hardware buffer, index buffers included, was created and uploaded
through GL_ARRAY_BUFFER. GL allows it, but the driver then believes it
holds vertices. Mali Utgard (Mesa lima) needs the min/max index of every
indexed draw; lima and panfrost cache it per index buffer, and only
create that cache for buffers bound as GL_ELEMENT_ARRAY_BUFFER. Without
it, every glDrawElements of every frame maps the index buffer and reads
all its indices back from write-combined (uncached) GPU memory. On an
Allwinner A33 that cost about 0.12 ms of the main thread per 1000
vertices drawn, more than half of the frame at viewing range 96.

The draw path already binds index buffers as GL_ELEMENT_ARRAY_BUFFER;
now they are also created there, and so is the quad index buffer.

Upstream: not sent yet.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>

diff --git a/irr/src/OpenGL/BufferObject.h b/irr/src/OpenGL/BufferObject.h
index d99395469..99afae57d 100644
--- a/irr/src/OpenGL/BufferObject.h
+++ b/irr/src/OpenGL/BufferObject.h
@@ -15,6 +15,7 @@ class OGLBufferObject
 public:
 	enum Target : GLenum {
 		TARGET_VBO = GL_ARRAY_BUFFER,
+		TARGET_IBO = GL_ELEMENT_ARRAY_BUFFER,
 		TARGET_UBO = GL_UNIFORM_BUFFER,
 	};
 
@@ -43,14 +44,14 @@ class OGLBufferObject
 	 * @param offset offset to upload at
 	 * @param usage usage pattern passed to GL (only if buffer is new)
 	 * @param mustShrink force re-create of buffer if it became smaller
-	 * @note modifies GL_ARRAY_BUFFER binding
+	 * @note modifies the binding of its target
 	 */
 	void upload(const void *data, size_t size, size_t offset,
 		GLenum usage, bool mustShrink = false);
 
 	/**
 	 * Free buffer in GL.
-	 * @note modifies GL_ARRAY_BUFFER binding
+	 * @note modifies the binding of its target
 	 */
 	void destroy();
 
diff --git a/irr/src/OpenGL/Driver.h b/irr/src/OpenGL/Driver.h
index b984a448c..fe640b74d 100644
--- a/irr/src/OpenGL/Driver.h
+++ b/irr/src/OpenGL/Driver.h
@@ -44,7 +44,9 @@ class COpenGL3DriverBase : public CNullDriver, public IMaterialRendererServices,
 
 	struct SHWBufferLink_opengl : public SHWBufferLink
 	{
-		SHWBufferLink_opengl(const scene::HWBuffer *buf) : SHWBufferLink(buf), Vbo(OGLBufferObject::TARGET_VBO) {}
+		SHWBufferLink_opengl(const scene::HWBuffer *buf) : SHWBufferLink(buf),
+			Vbo(buf->getBufferType() == scene::HWBuffer::Type::INDEX ?
+				OGLBufferObject::TARGET_IBO : OGLBufferObject::TARGET_VBO) {}
 
 		OGLBufferObject Vbo;
 	};
@@ -353,7 +355,7 @@ class COpenGL3DriverBase : public CNullDriver, public IMaterialRendererServices,
 
 	bool EnableErrorTest;
 
-	OGLBufferObject QuadIndexVBO = OGLBufferObject(OGLBufferObject::TARGET_VBO);
+	OGLBufferObject QuadIndexVBO = OGLBufferObject(OGLBufferObject::TARGET_IBO);
 	void initQuadsIndices(u32 max_vertex_count = 65536);
 
 	u16 MaxJointTransforms = 0;
