From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Maicon Alves <alvesmaiconn@gmail.com>
Date: Sat, 17 Oct 2026 01:25:28 -0300
Subject: [PATCH 26/26] mainmenu: a bonus chest asked for when creating a world
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Minecraft asks whether the new world starts with a bonus chest. A checkbox under "Allow changing the
game mode" writes bonus_chest to world.mt, for the game to place the chest (goodluckOS's
minetest_game: goodluck_bonus_chest). pt_BR: "Baú inicial".

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>

diff --git a/builtin/mainmenu/dlg_create_world.lua b/builtin/mainmenu/dlg_create_world.lua
index 98ef4d8a6..6e60c4e70 100644
--- a/builtin/mainmenu/dlg_create_world.lua
+++ b/builtin/mainmenu/dlg_create_world.lua
@@ -157,7 +157,9 @@ local function create_world_formspec(dialogdata)
 		return ("button[%g,%g;%g,0.5;btn_game_mode;%s]"):format(x, y, w,
 				fgettext("Game mode: $1", fgettext_ne(dialogdata.creative and "Creative" or "Survival"))) ..
 			("checkbox[%g,%g;cb_mode_change;%s;%s]"):format(x, y + 0.7,
-				fgettext("Allow changing the game mode"), tostring(dialogdata.mode_change))
+				fgettext("Allow changing the game mode"), tostring(dialogdata.mode_change)) ..
+			("checkbox[%g,%g;cb_bonus_chest;%s;%s]"):format(x, y + 1.25,
+				fgettext("Bonus chest"), tostring(dialogdata.bonus_chest))
 	end
 
 	-- a handheld types the name with the gamepad's keyboard (left empty, the next free one), and keeps the
@@ -426,6 +428,8 @@ local function create_world_buttonhandler(this, fields)
 			local world = menudata.worldlist:get_raw_element(index)
 			local conf = Settings(world.path .. DIR_DELIM .. "world.mt")
 			conf:set_bool("allow_mode_change", this.data.mode_change)
+			-- as Minecraft's: a chest of things to start with by the spawn
+			conf:set_bool("bonus_chest", this.data.bonus_chest)
 			conf:write()
 		end
 
@@ -447,6 +451,11 @@ local function create_world_buttonhandler(this, fields)
 		return true
 	end
 
+	if fields["cb_bonus_chest"] then
+		this.data.bonus_chest = core.is_yes(fields["cb_bonus_chest"])
+		return true
+	end
+
 	if fields["games"] then
 		local gameindex = core.get_textlist_index("games")
 		core.settings:set("menu_last_game", pkgmgr.games[gameindex].id)
@@ -500,6 +509,7 @@ function create_create_world_dlg()
 		worldname = "",
 		creative = false,
 		mode_change = false,
+		bonus_chest = false,
 		-- settings the world is created with:
 		seed = core.settings:get("fixed_map_seed") or "",
 		flags = {
diff --git a/po/pt_BR/luanti.po b/po/pt_BR/luanti.po
index 5cf768266..5524ae505 100644
--- a/po/pt_BR/luanti.po
+++ b/po/pt_BR/luanti.po
@@ -1080,6 +1080,10 @@ msgstr "Criativo"
 msgid "Allow changing the game mode"
 msgstr "Permitir trocar de modo"
 
+#: builtin/mainmenu/dlg_create_world.lua
+msgid "Bonus chest"
+msgstr "Baú inicial"
+
 #: src/client/clientlauncher.cpp
 msgid "space"
 msgstr "espaço"
