+/*
+	The terrain around where the player comes in, before the world shows (singleplayer):
+	the loading screen stays until the server has sent, culled or left out as air every block
+	within loading_terrain_radius nodes (or all it sends, when that is less) and the client has made
+	their meshes, the simplified far ones too, or for at most loading_terrain_timeout seconds.
+	The player's look comes with the position, so the blocks asked for are those the player will
+	see first; the camera and the draw list are updated as each frame does, which is what asks for
+	the far meshes.
+*/
+bool Game::loadTerrain()
+{
+	const s16 radius = g_settings->getS16("loading_terrain_radius");
+	if (radius <= 0 || !server)
+		return true;
+	const s16 blocks = (radius + MAP_BLOCKSIZE - 1) / MAP_BLOCKSIZE;
+	const float timeout = g_settings->getFloat("loading_terrain_timeout");
+	// what the camera sets each frame, for the position sent meanwhile
+	camera->updateViewingRange();
+	// the rest of the bar; the server starts its sweep again when the player moves to another block or turns,
+	// so the bar shows the farthest it got
+	m_rendering_engine->setLoadScreenRange(60, 100);
+	s16 farthest = 0;
+	bool placed = false;
+	u32 sends_before = 0;
+	u64 settled_ms = 0;
+
+	FpsControl fps_control;
+	f32 dtime;
+	fps_control.reset();
+	const u64 start = porting::getTimeMs();
+	while (m_rendering_engine->run()) {
+		fps_control.limit(device, &dtime);
+		step(dtime);
+
+		if (!checkConnection())
+			return false;
+		if (client->getState() < LC_Init) {
+			errordata->message = gettext("Client disconnected");
+			errorstream << errordata->message << std::endl;
+			return false;
+		}
+
+		const u64 now = porting::getTimeMs();
+		const float waited = (now - start) / 1000.0f;
+		s16 sent = 0;
+		u32 sends = 0;
+		if (client->playerPosReceived() && server->getMapSendProgress(sent, sends)) {
+			if (!placed) {
+				placed = true;
+				sends_before = sends;
+			}
+			updateCameraOffset();
+			updateCamera(dtime);
+			client->getEnv().getClientMap().updateDrawList();
+		}
+		const bool swept = placed && (sent > blocks || sends > sends_before);
+		farthest = std::max(farthest, swept ? blocks : sent);
+		// all there and meshed for half a second: arriving blocks get far meshes asked for on the next draw list
+		if (swept && client->meshesDone()) {
+			if (!settled_ms)
+				settled_ms = now;
+		} else {
+			settled_ms = 0;
+		}
+		const bool done = settled_ms && now - settled_ms >= 500;
+		if (done || waited >= timeout) {
+			actionstream << "Terrain within " << radius << " nodes " << (done ? "loaded" : "not loaded")
+				<< " after " << std::fixed << std::setprecision(1) << waited << " s" << std::endl;
+			m_rendering_engine->draw_load_screen(wstrgettext("Done!"), guienv, texture_src, 0, 100);
+			return true;
+		}
+
+		const int progress = 99 * std::min(farthest, blocks) / blocks;
+		m_rendering_engine->draw_load_screen(wstrgettext("Loading terrain..."), guienv, texture_src,
+				dtime, progress);
+	}
+	return false;
+}
