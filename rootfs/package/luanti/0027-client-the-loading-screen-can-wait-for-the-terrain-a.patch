+bool Server::getMapSendProgress(s16 &nearest_unsent, u32 &full_sends)
+{
+	ClientInterface::AutoLock clientlock(m_clients);
+	for (const auto &client_it : m_clients.getClientList()) {
+		if (client_it.second->getState() >= CS_Active) {
+			nearest_unsent = client_it.second->getNearestUnsentD();
+			full_sends = client_it.second->getFullSends();
+			return true;
+		}
+	}
+	return false;
+}
