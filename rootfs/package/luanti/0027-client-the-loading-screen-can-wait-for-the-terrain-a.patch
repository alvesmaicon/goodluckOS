+s16 Server::getNearestUnsentDistance()
+{
+	ClientInterface::AutoLock clientlock(m_clients);
+	for (const auto &client_it : m_clients.getClientList()) {
+		if (client_it.second->getState() >= CS_Active)
+			return client_it.second->getNearestUnsentD();
+	}
+	return 0;
+}
