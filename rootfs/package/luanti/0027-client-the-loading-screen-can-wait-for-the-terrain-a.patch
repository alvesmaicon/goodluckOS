+/*
+	The terrain around where the player comes in, before the world shows (singleplayer):
+	the loading screen stays until the server has sent, culled or left out as air every block
+	within loading_terrain_radius nodes and the client has made their meshes, or for at most
+	loading_terrain_timeout seconds. The player's look comes with the position, so the blocks
+	asked for are those the player will see first.
+*/
+bool Game::loadTerrain()
+{
+	const s16 radius = g_settings->getS16("loading_terrain_radius");
+	if (radius <= 0 || !server)
+		return true;
+	const s16 blocks = (radius + MAP_BLOCKSIZE - 1) / MAP_BLOCKSIZE;
+	const float timeout = g_settings->getFloat("loading_terrain_timeout");
+	// what the camera sets each frame, for the position sent meanwhile
+	camera->updateViewingRange();
+
+	FpsControl fps_control;
+	f32 dtime;
+	fps_control.reset();
+	const u64 start = porting::getTimeMs();
+	while (m_rendering_engine->run()) {
+		fps_control.limit(device, &dtime);
+		step(dtime);
+
+		if (!checkConnection())
+			return false;
+		if (client->getState() < LC_Init) {
+			errordata->message = gettext("Client disconnected");
+			errorstream << errordata->message << std::endl;
+			return false;
+		}
+
+		const float waited = (porting::getTimeMs() - start) / 1000.0f;
+		const s16 sent = client->playerPosReceived() ? server->getNearestUnsentDistance() : 0;
+		const bool done = sent > blocks && client->meshesDone();
+		if (done || waited >= timeout) {
+			actionstream << "Terrain within " << radius << " nodes " << (done ? "loaded" : "not loaded")
+				<< " after " << std::fixed << std::setprecision(1) << waited << " s" << std::endl;
+			m_rendering_engine->draw_load_screen(wstrgettext("Done!"), guienv, texture_src, 0, 100);
+			return true;
+		}
+
+		const int progress = 70 + 29 * std::min(sent, blocks) / blocks;
+		m_rendering_engine->draw_load_screen(wstrgettext("Loading terrain..."), guienv, texture_src,
+				dtime, progress);
+	}
+	return false;
+}
