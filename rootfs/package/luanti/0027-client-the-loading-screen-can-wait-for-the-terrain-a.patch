 #    View distance in nodes.
 viewing_range (Viewing range) int 190 20 4000
 
+#    In singleplayer, the loading screen stays until the terrain this many nodes
+#    around where the player comes in is loaded and drawn, so the world doesn't
+#    show building itself. 0 enters at once, as before.
+loading_terrain_radius (Terrain loaded before entering) int 0 0 320
+
+#    The longest the loading screen waits for that terrain, in seconds.
