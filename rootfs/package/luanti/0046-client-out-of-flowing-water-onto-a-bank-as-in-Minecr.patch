From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Maicon Alves <alvesmaiconn@gmail.com>
Date: Sat, 31 Oct 2026 22:04:17 -0300
Subject: [PATCH 46/46] client: out of flowing water onto a bank as in
 Minecraft

Out of a stream onto a bank one node high, as below a waterfall in a
cave, the player failed wherever the water was 0.6 deep or less at 15
FPS, 0.2 or less at 30, even with jump held: it bounced at the bank 0.6
to 0.9 high and never got on it. Three things did it.

The engine's liquid resistance still braked the player whenever the feet
were in a node of water but over its drawn surface, as when jumping or
stepping out of flowing water: a third of the speed lost each frame at
30 FPS, two thirds at 15, on every axis. Water now has none, as the
player under its surface already had.

The lift from a wall pushed on at the surface fired as soon as the box
0.6 higher was over the water's surface, and set the vertical speed to
its own 6.85 m/s. In shallow water it caught the player in the air before
the feet were back on the bed, so the jump never came, and it cut a jump
that rose faster. Minecraft's jumpOutOfFluid lifts only when the box 0.6
higher touches no block with a fluid in it, whatever its level
(Level.containsAnyLiquid), which a player standing in a stream never has:
there the jump from the bed takes the player out. The lift now asks the
same and never slows a player rising faster. Still water lifts as before,
a source filling its node.

A jump from the bed of water at most 0.4 deep was braked as in the water
until the feet left it. Minecraft's player is out of such water after the
jump's first tick and rises in the air; this jump now rises in Minecraft's
air from its start, as on land.

Checked in the native build in a cave with a waterfall against its back
wall falling into a channel 1 wide, the flow made by the engine (levels 7
to 0 from the fall), a bank 1 high beside it, forward and jump held
against the bank, until the player stands on it (Minecraft, tick by
tick: the feet over the bank 0.40 s after the keys in water deeper than
0.4, 0.20 s shallower, about 0.25 s more to step on it; without jump,
never). Before, at 15 FPS: 0.76 s at the foot of the fall, 0.69 to 0.78
in the three deepest levels, never in the five shallower ones (the feet
0.57 to 0.95 high), never tapping jump at depth 0.56. Now, at 15 and 30
FPS: 0.74 to 0.78 at the fall and in the deep levels, 0.44 to 0.52 in
the shallow ones (0.38 to 0.43 from a dry channel), 0.9 to 1.2 s tapping
jump. Without jump the player no longer drifts down the stream until a
lift carries it out: as in Minecraft, it stays. Still water, the speeds
in and under water, the current, the jumps and the falls measure as
before (the jump 1.26 high, out of deep water at a wall the feet 0.68
over the water).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>

diff --git a/src/client/clientenvironment.cpp b/src/client/clientenvironment.cpp
index c41a0fe63..ef7adac6c 100644
--- a/src/client/clientenvironment.cpp
+++ b/src/client/clientenvironment.cpp
@@ -126,7 +126,9 @@ void ClientEnvironment::step(float dtime)
 
 		// Apply physics (Minecraft's water has its own, in applyControl)
 		lplayer->gravity = 0;
-		if (!free_move && !lplayer->water_move) {
+		if (lplayer->water_jump) {
+			lplayer->gravity = lplayer->getAirGravity(dtime_part);
+		} else if (!free_move && !lplayer->water_move) {
 			// Gravity, Minecraft's air
 			if (!is_climbing && !lplayer->in_liquid)
 				lplayer->gravity = lplayer->getAirGravity(dtime_part);
diff --git a/src/client/localplayer.cpp b/src/client/localplayer.cpp
index d4e186d05..84db16246 100644
--- a/src/client/localplayer.cpp
+++ b/src/client/localplayer.cpp
@@ -307,6 +307,20 @@ static v3f water_flow(Map *map, const NodeDefManager *nodemgr, v3s16 p, MapNode
 	return flow;
 }
 
+// Any node of water in the box, its level aside, as Minecraft's containsAnyLiquid
+static bool water_in_box(Map *map, const NodeDefManager *nodemgr, const aabb3f &box)
+{
+	const v3s16 p0 = floatToInt(box.MinEdge + 0.001f * BS, BS);
+	const v3s16 p1 = floatToInt(box.MaxEdge - 0.001f * BS, BS);
+	v3s16 p;
+	for (p.X = p0.X; p.X <= p1.X; p.X++)
+	for (p.Y = p0.Y; p.Y <= p1.Y; p.Y++)
+	for (p.Z = p0.Z; p.Z <= p1.Z; p.Z++)
+		if (is_water(nodemgr->get(map->getNode(p))))
+			return true;
+	return false;
+}
+
 void LocalPlayer::updateWater(Map *map, const NodeDefManager *nodemgr, const v3f &position)
 {
 	water_depth = 0.0f;
@@ -351,7 +365,7 @@ void LocalPlayer::move(f32 dtime, Environment *env,
 
 	// Temporary option for old move code
 	if (!physics_override.new_move) {
-		water_move = m_water_air = false;
+		water_move = water_jump = m_water_air = false;
 		old_move(dtime, env, collision_info);
 		return;
 	}
@@ -413,7 +427,7 @@ void LocalPlayer::move(f32 dtime, Environment *env,
 		if (is_valid_position) {
 			const ContentFeatures &cf = nodemgr->get(node.getContent());
 			in_liquid = cf.liquid_move_physics && !is_water(cf);
-			move_resistance = cf.move_resistance;
+			move_resistance = is_water(cf) ? 0 : cf.move_resistance;
 		} else {
 			in_liquid = false;
 		}
@@ -425,7 +439,7 @@ void LocalPlayer::move(f32 dtime, Environment *env,
 		if (is_valid_position) {
 			const ContentFeatures &cf = nodemgr->get(node.getContent());
 			in_liquid = cf.liquid_move_physics && !is_water(cf);
-			move_resistance = cf.move_resistance;
+			move_resistance = is_water(cf) ? 0 : cf.move_resistance;
 		} else {
 			in_liquid = false;
 		}
@@ -464,6 +478,7 @@ void LocalPlayer::move(f32 dtime, Environment *env,
 	}
 
 	water_move = water_depth > 0.0f && !free_move && !is_climbing;
+	water_jump = water_jump && water_move;
 
 	// Player object property step height is multiplied by BS in
 	// /src/script/common/c_content.cpp and /src/content_sao.cpp
@@ -488,15 +503,16 @@ void LocalPlayer::move(f32 dtime, Environment *env,
 		&position, &m_speed, accel_f, m_cao, true, step_up_mode);
 
 	// As in Minecraft, pushing on a wall at the surface lifts the player, at 0.3 a tick in its air,
-	// when the box 0.6 higher (and a tick on) has no water and nothing solid
+	// when the box 0.6 higher (and a tick on) touches no node of water and nothing solid
 	if (water_move) {
 		bool wall = false;
 		for (const auto &colinfo : result.collisions)
 			wall |= colinfo.type == COLLISION_NODE && colinfo.axis != COLLISION_AXIS_Y;
-		if (wall && water_depth <= 0.6f + m_speed.Y / (20.0f * BS) &&
-				!collision_check_intersection(env, m_client, m_collisionbox,
-				position + v3f(0.0f, 0.6f * BS, 0.0f), m_cao))
-			m_speed.Y = getAirSpeed(0.3f);
+		const v3f above = position + v3f(0.0f, 0.6f * BS + m_speed.Y / 20.0f, 0.0f);
+		if (wall && !water_in_box(map, nodemgr, aabb3f(above + m_collisionbox.MinEdge,
+				above + m_collisionbox.MaxEdge)) &&
+				!collision_check_intersection(env, m_client, m_collisionbox, above, m_cao))
+			m_speed.Y = std::max(m_speed.Y, getAirSpeed(0.3f));
 	}
 
 	bool could_sneak = control.sneak && !free_move && !in_liquid &&
@@ -1024,14 +1040,19 @@ void LocalPlayer::applyWaterControl(float dtime, Environment *env)
 
 	// v = (v + steer * (look - v) + push) * 0.8 - sink
 	f32 push = m_water_current.Y;
+	water_jump = water_jump && m_speed.Y > 0.0f;
 	if (control.jump && !m_disable_jump && (!touching_ground || water_depth > 0.4f)) {
 		push += 0.04f;
 		swimming_vertical = true;
 	} else if (control.jump && m_can_jump && m_jump_delay <= 0.0f) {
 		m_speed.Y = getJumpSpeed();
 		m_jump_delay = 0.5f;
+		water_jump = true;
 		m_client->getEventManager()->put(new SimpleTriggerEvent(MtEvent::PLAYER_JUMP));
 	}
+	// Minecraft's jump from the bed of shallow water is out of it in a tick: it rises in the air (ClientEnvironment)
+	if (water_jump)
+		return;
 	if (control.sneak && !m_disable_descend) {
 		push -= 0.04f;
 		swimming_vertical = true;
