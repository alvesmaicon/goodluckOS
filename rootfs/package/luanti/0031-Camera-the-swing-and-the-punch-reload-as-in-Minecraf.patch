From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Maicon Alves <alvesmaiconn@gmail.com>
Date: Fri, 23 Oct 2026 11:32:04 -0300
Subject: [PATCH 31/31] Camera: the swing and the punch reload as in Minecraft

The dig swing moved the item 50 units left, up and back down while
turning it towards a fixed pose, and pushed it 12.5 units away for the
whole swing. Those numbers were sized for the default rest pose: with
the handheld's closer pose a sword's grip went to the middle of the
screen and its blade up past the crosshair, round in a circle. After a
punch the item also slid 35 units left and turned 70 degrees while the
punch reloaded.

The swing now follows Minecraft's ItemInHandRenderer: 0.3 s, a turn
about an axis yawed off the view and a shift, both driven by
sin(sqrt(p) pi), sin(p^2 pi), sin(2 sqrt(p) pi) and sin(p pi) (p is the
swing's progress), in blocks scaled to the rest pose's depth.
Minecraft's item leans its blade towards the camera and the handheld's
away from it, so Minecraft's numbers still took the grip to the middle
of the screen. The yaw (56 degrees instead of 45), the side turns (12
and 13 instead of 20), the shift (0.33, 0.17 and 0.12 block instead of
0.4, 0.2 and 0.2) and the point an item turns about (0.09 block below
its centre instead of 0.2) were fitted so a sword's grip and tip cross a
640x480 screen where Minecraft's cross a 16:9 one: the squared screen
distance summed over 13 steps of the swing is 7411 with Minecraft's
numbers and 246 with these. A node turns about its centre.

While digging, a swing past its half snaps back in 0.05 s and starts
again, as Minecraft repeats the first half of the swing when mining, so
a dig hits every 0.2 s and its sound with it. A click still swings once
for 0.3 s.

After a punch the item drops straight down by 0.6 block and rises with
the cube of the reload ratio, as Minecraft's attack cooldown lowers it;
its height moves at most 8 times its range a second (0.4 a tick in
Minecraft), so the drop takes 0.125 s.

Checked in the native build at 640x480: frames at fixed swing progress
and reload ratio for a sword, a pick, a dirt block and the hand, and a
log of the swing while digging stone (cycles of 0.25 s at 28 FPS, one
0.3 s swing for a click).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>

diff --git a/src/client/camera.cpp b/src/client/camera.cpp
index a94c15f32..ae3832bc5 100644
--- a/src/client/camera.cpp
+++ b/src/client/camera.cpp
@@ -196,13 +196,15 @@ void Camera::step(f32 dtime)
 	}
 
 	if (m_digging_button != -1) {
-		f32 offset = dtime * 3.5f;
+		// A swing takes 0.3 s; one that goes on digging snaps back in 0.05 s
+		f32 offset = dtime * (m_digging_snap ? 10.0f : 1.0f / 0.3f);
 		float m_digging_anim_was = m_digging_anim;
 		m_digging_anim += offset;
 		if (m_digging_anim >= 1)
 		{
 			m_digging_anim = 0;
 			m_digging_button = -1;
+			m_digging_snap = false;
 		}
 		float lim = 0.15;
 		if(m_digging_anim_was < lim && m_digging_anim >= lim)
@@ -525,36 +527,27 @@ void Camera::update(LocalPlayer* player, f32 frametime, f32 tool_reload_ratio)
 			m_wieldmesh_offset.Y - WIELDMESH_OFFSET_Y, 0);
 	v3f wield_rotation = m_wield_rotation[pose];
 	wield_position.Y += std::abs(m_wield_change_timer)*320 - 40;
-	if(m_digging_anim < 0.05 || m_digging_anim > 0.5)
-	{
-		f32 frac = 1.0;
-		if(m_digging_anim > 0.5)
-			frac = 2.0 * (m_digging_anim - 0.5);
-		// This value starts from 1 and settles to 0
-		f32 ratiothing = std::pow((1.0f - tool_reload_ratio), 0.5f);
-		f32 ratiothing2 = (easeCurve(ratiothing*0.5))*2.0;
-		wield_position.Y -= frac * 25.0f * std::pow(ratiothing2, 1.7f);
-		wield_position.X -= frac * 35.0f * std::pow(ratiothing2, 1.1f);
-		wield_rotation.Y += frac * 70.0f * std::pow(ratiothing2, 1.4f);
-	}
+
+	// Minecraft's swing and punch reload, in blocks at the rest pose's depth; the angles and
+	// distances are fitted so a sword's grip and tip cross the screen where Minecraft's do
+	const v3f hand = pose ? v3f(0, 0, 0) : v3f(0.035f, 0.09f, 0);
+	const f32 block = m_wield_position[pose].Z / (pose ? 0.72f : 0.65f);
+	const f32 step = 8.0f * frametime;
+	m_wield_height += rangelim(std::pow(tool_reload_ratio, 3.0f) - m_wield_height, -step, step);
+	wield_position.Y -= 0.6f * (1.0f - m_wield_height) * block;
 	if (m_digging_button != -1)
 	{
-		f32 digfrac = m_digging_anim;
-		wield_position.X -= 50 * std::sin(std::pow(digfrac, 0.8f) * M_PI);
-		wield_position.Y += 24 * std::sin(digfrac * 1.8 * M_PI);
-		wield_position.Z += 25 * 0.5;
-
-		// Euler angles are PURE EVIL, so why not use quaternions?
-		// The swing turns the item from its rest pose as it turns the default one to (80, 30, 100)
-		core::quaternion quat_begin(wield_rotation * core::DEGTORAD);
-		core::quaternion swing(v3f(-100, 120, -100) * core::DEGTORAD);
-		swing.makeInverse();
-		swing = swing * core::quaternion(v3f(80, 30, 100) * core::DEGTORAD);
-		core::quaternion quat_end = quat_begin * swing;
-		core::quaternion quat_slerp;
-		quat_slerp.slerp(quat_begin, quat_end, std::sin(digfrac * M_PI));
-		quat_slerp.toEuler(wield_rotation);
-		wield_rotation *= core::RADTODEG;
+		const f32 p = m_digging_anim;
+		const f32 s = std::sin(std::sqrt(p) * M_PI);
+		core::matrix4 yaw, chop, unyaw, rest;
+		yaw.setRotationDegrees(v3f(0, 12 * std::sin(p * p * M_PI) - 56, 0));
+		chop.setRotationDegrees(v3f(80 * s, 0, -13 * s));
+		unyaw.setRotationDegrees(v3f(0, 56, 0));
+		const core::matrix4 swing = yaw * chop * unyaw;
+		rest.setRotationDegrees(wield_rotation);
+		wield_rotation = (swing * rest).getRotationDegrees();
+		wield_position += (swing.rotateAndScaleVect(hand) - hand + v3f(-0.33f * s,
+				0.17f * std::sin(std::sqrt(p) * 2 * M_PI), 0.12f * std::sin(p * M_PI))) * block;
 	} else {
 		f32 bobfrac = my_modf(m_view_bobbing_anim);
 		wield_position.X -= std::sin(bobfrac*M_PI*2.0) * 3.0;
@@ -617,6 +610,8 @@ void Camera::setDigging(s32 button)
 	} else if (m_digging_button == -1) {
 		// Any other action.
 		m_digging_button = button;
+	} else if (m_digging_button == 0 && m_digging_anim >= 0.5f) {
+		m_digging_snap = true;
 	}
 }
 
diff --git a/src/client/camera.h b/src/client/camera.h
index 32eb39f79..ca041aac2 100644
--- a/src/client/camera.h
+++ b/src/client/camera.h
@@ -261,6 +261,10 @@ class Camera
 	// If 0, left-click digging animation
 	// If 1, right-click digging animation
 	s32 m_digging_button = -1;
+	// The swing passed its half while still digging: it snaps back to start again
+	bool m_digging_snap = false;
+	// Height of the wielded item after a punch, 0 (lowered) to 1, as the punch reloads
+	f32 m_wield_height = 1.0f;
 
 	// Animation when changing wielded item
 	f32 m_wield_change_timer = 0.125f;
