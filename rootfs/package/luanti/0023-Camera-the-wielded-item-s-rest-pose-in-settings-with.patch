 	const ContentFeatures &f = ndef->get(def.name);
 	const NodeVisuals &v = *(f.visuals);
+	m_node_mesh = false;
 
 	{
 		// Initialize material type used by setExtruded
@@ -527,6 +528,7 @@ void WieldMeshSceneNode::setItem(const ItemStack &item, Client *client, bool che
 			mesh = createGenericNodeMesh(client, n, &m_buffer_info, f);
 			changeToMesh(mesh);
 			mesh->drop();
+			m_node_mesh = true;
 			m_meshnode->setScale(
 				wield_scale * WIELD_SCALE_FACTOR
 				/ (BS * f.visual_scale));
diff --git a/src/client/wieldmesh.h b/src/client/wieldmesh.h
index 3dd4a5e64..78c9b57b4 100644
--- a/src/client/wieldmesh.h
+++ b/src/client/wieldmesh.h
@@ -133,6 +133,9 @@ class WieldMeshSceneNode : public scene::ISceneNode
 
 	scene::IMesh *getMesh() { return m_meshnode->getMesh(); }
 
+	// Drawn as the node itself (a cube...), not as an extruded image
+	bool isNodeMesh() const { return m_node_mesh; }
+
 	virtual void render();
 
 	virtual const aabb3f &getBoundingBox() const { return m_bounding_box; }
@@ -145,6 +148,7 @@ class WieldMeshSceneNode : public scene::ISceneNode
 
 	// Child scene node with the current wield mesh
 	scene::IMeshSceneNode *m_meshnode = nullptr;
+	bool m_node_mesh = false;
 	// Material types used as fallback
 	video::E_MATERIAL_TYPE m_material_type;
 
diff --git a/src/defaultsettings.cpp b/src/defaultsettings.cpp
index 6f845b6f2..069a68a51 100644
--- a/src/defaultsettings.cpp
+++ b/src/defaultsettings.cpp
@@ -311,6 +311,10 @@ void set_default_settings()
