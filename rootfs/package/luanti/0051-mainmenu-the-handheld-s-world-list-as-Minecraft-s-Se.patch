+		return index
+	end
+	index = filterlist.get_current_index(menudata.worldlist,
+			tonumber(core.settings:get("mainmenu_last_selected_world")))
+	if index == 0 and menudata.worldlist:size() > 0 then
+		return 1
+	end
+	return index > 0 and index or nil
+end
