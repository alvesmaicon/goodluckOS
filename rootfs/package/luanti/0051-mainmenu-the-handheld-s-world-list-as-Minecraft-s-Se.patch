+local function world_icon(world)
+	local icon = world.path .. DIR_DELIM .. "icon.png"
+	local file = io.open(icon, "rb")
+	if file then
+		file:close()
+		return icon
+	end
+	local game = pkgmgr.find_by_gameid(world.gameid)
+	return game and game.menuicon_path or ""
+end
