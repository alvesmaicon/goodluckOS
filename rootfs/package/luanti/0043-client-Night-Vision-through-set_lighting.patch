From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Maicon Alves <alvesmaiconn@gmail.com>
Date: Thu, 29 Oct 2026 20:17:58 -0300
Subject: [PATCH 43/43] client: Night Vision through set_lighting

A player's lighting gets night_vision, from 0 (off) to 1: everything they see
is as lit as its brightest light, Minecraft's Night Vision. Minecraft scales
its lightmap's colour up to its brightest channel; here the node and object
vertex shaders do the same to the light they have computed. A node's light
comes with its face's shade baked in, so the shade is worked out again from
the normal with applyFacesShading's factors and kept; objects keep theirs
(vIDiff, applied later). The value rides at the end of TOCLIENT_SET_LIGHTING,
read only when it is there.

The mod changes it every step in the last 10 s to make Minecraft's flicker.
Measured nothing on the A33 yet: a uniform branch, off unless the effect is on.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>

diff --git a/client/shaders/nodes_shader/opengl_vertex.glsl b/client/shaders/nodes_shader/opengl_vertex.glsl
index ea26b06ac..41abd6bd8 100644
--- a/client/shaders/nodes_shader/opengl_vertex.glsl
+++ b/client/shaders/nodes_shader/opengl_vertex.glsl
@@ -7,6 +7,7 @@ uniform highp vec3 cameraOffset;
 uniform float animationTimer;
 uniform float fogDistance;
 uniform float fogShadingParameter;
+uniform float nightVision;
 
 VARYING_ vec3 vNormal;
 // World position in the visible world (i.e. relative to the cameraOffset.)
@@ -216,6 +217,16 @@ void main(void)
 	nightRatio = 1.0 - color.a;
 	color.rgb = color.rgb * (color.a * dayLight.rgb +
 		nightRatio * artificialLight.rgb) * 2.0;
+	// Night Vision as Minecraft's: the light scaled up to its brightest channel. The face's shade, baked in with the
+	// light, comes back from its normal (applyFacesShading's factors)
+	if (nightVision > 0.0) {
+		vec3 n2 = inVertexNormal * inVertexNormal;
+		float shade = n2.x + n2.y + n2.z < 0.001 ? 1.0 :
+			dot(n2, vec3(0.670820, inVertexNormal.y < 0.0 ? 0.447213 : 1.0, 0.836660));
+		float top = max(color.r, max(color.g, color.b));
+		vec3 lit = top > 0.004 ? color.rgb * (shade / top) : vec3(shade);
+		color.rgb = mix(color.rgb, lit, nightVision);
+	}
 	// fog clarity rides in the alpha: fp32 here, the fragment stage may be fp16
 	color.a = fogShadingParameter - fogShadingParameter * length(eyeVec) / fogDistance;
 
diff --git a/client/shaders/object_shader/opengl_vertex.glsl b/client/shaders/object_shader/opengl_vertex.glsl
index 00e0dd7ce..1c539bad0 100644
--- a/client/shaders/object_shader/opengl_vertex.glsl
+++ b/client/shaders/object_shader/opengl_vertex.glsl
@@ -2,6 +2,7 @@ uniform mat4 mWorld;
 uniform vec3 dayLight;
 uniform float animationTimer;
 uniform lowp vec4 materialColor;
+uniform float nightVision;
 
 VARYING_ vec3 vNormal;
 VARYING_ vec3 worldPosition;
@@ -147,6 +148,11 @@ void main(void)
 	color.rgb = color.rgb * (color.a * dayLight.rgb +
 		nightRatio * artificialLight.rgb) * 2.0;
 	color.a = 1.0;
+	// Night Vision as Minecraft's: the light scaled up to its brightest channel (the shade is vIDiff's)
+	if (nightVision > 0.0) {
+		float top = max(color.r, max(color.g, color.b));
+		color.rgb = mix(color.rgb, top > 0.004 ? color.rgb / top : vec3(1.0), nightVision);
+	}
 
 	// Emphase blue a bit in darker places
 	// See C++ implementation in mapblock_mesh.cpp final_color_blend()
diff --git a/doc/lua_api.md b/doc/lua_api.md
index 20ec6d025..1f63599b7 100644
--- a/doc/lua_api.md
+++ b/doc/lua_api.md
@@ -9695,6 +9695,9 @@ You **must not** mix names and track numbers to refer to the same animation.
             * Currently, bloom `intensity` and `strength_factor` affect volumetric
               lighting `strength` and vice versa. This behavior is to be changed
               in the future, do not rely on it.
+      * `night_vision`: from 0 (off, default) to 1, everything the player sees
+        as lit as its brightest light, faces still shaded (Minecraft's Night
+        Vision; handheld fork)
 
 * `get_lighting()`: returns the current state of lighting for the player.
     * Result is a table with the same fields as `light_definition` in `set_lighting`.
diff --git a/src/client/game.cpp b/src/client/game.cpp
index 91e744d10..19f17dfb8 100644
--- a/src/client/game.cpp
+++ b/src/client/game.cpp
@@ -101,6 +101,7 @@ class GameGlobalShaderUniformSetter : public IShaderUniformSetter
 	CachedPixelShaderSetting<float> m_bloom_strength_pixel{"bloomStrength"};
 	CachedPixelShaderSetting<float> m_bloom_radius_pixel{"bloomRadius"};
 	CachedPixelShaderSetting<float> m_saturation_pixel{"saturation"};
+	CachedPixelShaderSetting<float> m_night_vision{"nightVision"};
 	bool m_volumetric_light_enabled;
 	CachedPixelShaderSetting<float, 3>
 		m_sun_position_pixel{"sunPositionScreen"};
@@ -214,6 +215,9 @@ class GameGlobalShaderUniformSetter : public IShaderUniformSetter
 		float saturation = lighting.saturation;
 		m_saturation_pixel.set(&saturation, services);
 
+		float night_vision = lighting.night_vision;
+		m_night_vision.set(&night_vision, services);
+
 		if (m_volumetric_light_enabled) {
 			// Map directional light to screen space
 			auto camera_node = m_client->getCamera()->getCameraNode();
diff --git a/src/lighting.h b/src/lighting.h
index d3144a7ef..339e196d1 100644
--- a/src/lighting.h
+++ b/src/lighting.h
@@ -53,4 +53,6 @@ struct Lighting
 	float bloom_strength_factor {1.0f};
 	float bloom_radius {1.0f};
 	v3f shadow_direction;
+	/// @brief Night Vision: 0 none, 1 everything as lit as the brightest light
+	float night_vision {0.0f};
 };
diff --git a/src/network/clientpackethandler.cpp b/src/network/clientpackethandler.cpp
index 5321dc565..1b28e4a13 100644
--- a/src/network/clientpackethandler.cpp
+++ b/src/network/clientpackethandler.cpp
@@ -1923,5 +1923,10 @@ void Client::handleCommand_SetLighting(NetworkPacket *pkt)
 			break;
 		// >= 5.16.0-dev
 		*pkt >> lighting.shadow_direction;
+
+		if (!pkt->hasRemainingBytes())
+			break;
+		// handheld
+		*pkt >> lighting.night_vision;
 	} while (0);
 }
diff --git a/src/script/lua_api/l_object.cpp b/src/script/lua_api/l_object.cpp
index d21ea6c94..0b7bbf7ba 100644
--- a/src/script/lua_api/l_object.cpp
+++ b/src/script/lua_api/l_object.cpp
@@ -2876,6 +2876,9 @@ int ObjectRef::l_set_lighting(lua_State *L)
 			lighting.bloom_radius          = getfloatfield_default(L, -1, "radius",          lighting.bloom_radius);
 		}
 		lua_pop(L, 1); // bloom
+
+		lighting.night_vision = rangelim(getfloatfield_default(L, 2, "night_vision", lighting.night_vision),
+				0.0f, 1.0f);
 }
 
 	getServer(L)->setLighting(player, lighting);
@@ -2930,6 +2933,8 @@ int ObjectRef::l_get_lighting(lua_State *L)
 	lua_pushnumber(L, lighting.bloom_radius);
 	lua_setfield(L, -2, "radius");
 	lua_setfield(L, -2, "bloom");
+	lua_pushnumber(L, lighting.night_vision);
+	lua_setfield(L, -2, "night_vision");
 	return 1;
 }
 
diff --git a/src/server.cpp b/src/server.cpp
index 061ba06d8..f9f2c483a 100644
--- a/src/server.cpp
+++ b/src/server.cpp
@@ -2078,6 +2078,8 @@ void Server::SendSetLighting(session_t peer_id, const Lighting &lighting)
 
 	pkt << lighting.shadow_direction;
 
+	pkt << lighting.night_vision;
+
 	Send(&pkt);
 }
 
