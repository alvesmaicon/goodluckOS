+				if (other.kind == SOLID) {
+					const bool inside = c2.X >= 0 && c2.X < m_cells && c2.Y >= 0 &&
+							c2.Y < m_cells && c2.Z >= 0 && c2.Z < m_cells;
+					if (inside)
+						continue;
+					dst = 1 + face;
+				}
