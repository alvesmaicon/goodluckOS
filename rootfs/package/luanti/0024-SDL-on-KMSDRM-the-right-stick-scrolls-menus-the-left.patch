From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Maicon Alves <alvesmaiconn@gmail.com>
Date: Sat, 17 Oct 2026 01:20:17 -0300
Subject: [PATCH 24/44] SDL on KMSDRM: the right stick scrolls menus, the left
 one moves the cursor

Both sticks moved the drawn cursor. The right one now turns the mouse wheel, a step every 250 ms
tilted a little and every 50 ms at full tilt; L1/R1 still turn it a step a press. Such a wheel is
marked (SMouseInput::Gamepad), and a form sends it to what scrolls under the cursor (scroll
container, scrollbar, list box, table, hypertext), else to its first scroll container, scrollbar or
table, so scrolling works wherever the cursor is, and never moves items as a wheel over an
inventory list does.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>

diff --git a/irr/include/IEventReceiver.h b/irr/include/IEventReceiver.h
index 58128b25c..aec05cb90 100644
--- a/irr/include/IEventReceiver.h
+++ b/irr/include/IEventReceiver.h
@@ -350,6 +350,9 @@ struct SEvent
 		//! Is this a simulated mouse event generated by the engine itself?
 		bool Simulated : 1;
 
+		//! A wheel turned by the gamepad (its right stick or shoulder buttons), which scrolls a menu, never its items
+		bool Gamepad : 1;
+
 		//! A bitmap of button states. You can use isButtonPressed() to determine
 		//! if a button is pressed or not.
 		u32 ButtonStates;
diff --git a/irr/src/CIrrDeviceSDL.cpp b/irr/src/CIrrDeviceSDL.cpp
index d03d4146e..bacc75355 100644
--- a/irr/src/CIrrDeviceSDL.cpp
+++ b/irr/src/CIrrDeviceSDL.cpp
@@ -1222,7 +1222,7 @@ bool CIrrDeviceSDL::gamepadButtonAsMouse(GamepadButton button, bool down)
 	case GamepadButton::LEFT_SHOULDER:
 	case GamepadButton::RIGHT_SHOULDER:
 		if (down)
-			postGamepadMouse(EMIE_MOUSE_WHEEL, button == GamepadButton::LEFT_SHOULDER ? 1.0f : -1.0f);
+			postGamepadWheel(button == GamepadButton::LEFT_SHOULDER ? 1.0f : -1.0f);
 		break;
 	default: // D-pad: moveCursorWithGamepad() reads it from GamepadMouseButtons
 		break;
@@ -1248,8 +1248,8 @@ void CIrrDeviceSDL::gamepadButtonToKeyboard(GamepadButton button, bool down)
 	}
 }
 
-//! Either stick moves the cursor (slowly near the center, a screen height per second at full tilt);
-//! the D-pad nudges it
+//! The left stick moves the cursor (slowly near the center, a screen height per second at full tilt) and the
+//! D-pad nudges it; the right stick scrolls, a step every 250 ms tilted a little, every 50 ms at full tilt
 void CIrrDeviceSDL::moveCursorWithGamepad()
 {
 	const u32 now = os::Timer::getRealTime();
@@ -1280,16 +1280,26 @@ void CIrrDeviceSDL::moveCursorWithGamepad()
 		return;
 	}
 
+	const f32 ry = GamepadAxes[static_cast<int>(GamepadAxis::RIGHTY)] / 32767.0f;
+	if (core::abs_(ry) >= 0.35f) {
+		if ((s32)(now - GamepadWheelTime) >= 0) {
+			const f32 tilt = core::min_((core::abs_(ry) - 0.35f) / 0.65f, 1.0f);
+			postGamepadWheel(ry < 0.0f ? 1.0f : -1.0f);
+			GamepadWheelTime = now + static_cast<u32>(250.0f - 200.0f * tilt);
+		}
+	} else {
+		GamepadWheelTime = now;
+	}
+
 	f32 vx = 0.0f, vy = 0.0f;
-	for (int axis : {static_cast<int>(GamepadAxis::LEFTX), static_cast<int>(GamepadAxis::RIGHTX)}) {
-		const f32 x = GamepadAxes[axis] / 32767.0f, y = GamepadAxes[axis + 1] / 32767.0f;
-		const f32 len = core::squareroot(x * x + y * y);
-		if (len < 0.25f)
-			continue;
+	const f32 lx = GamepadAxes[static_cast<int>(GamepadAxis::LEFTX)] / 32767.0f;
+	const f32 ly = GamepadAxes[static_cast<int>(GamepadAxis::LEFTY)] / 32767.0f;
+	const f32 len = core::squareroot(lx * lx + ly * ly);
+	if (len >= 0.25f) {
 		f32 speed = core::min_((len - 0.25f) / 0.75f, 1.0f);
 		speed *= speed;
-		vx += x / len * speed;
-		vy += y / len * speed;
+		vx += lx / len * speed;
+		vy += ly / len * speed;
 	}
 	const auto held = [this](GamepadButton b) {
 		return static_cast<f32>((GamepadMouseButtons >> static_cast<u32>(b)) & 1);
@@ -1345,6 +1355,19 @@ void CIrrDeviceSDL::postGamepadClick(u32 button, bool down)
 	}
 }
 
+void CIrrDeviceSDL::postGamepadWheel(f32 wheel)
+{
+	SEvent irrevent{};
+	irrevent.EventType = EET_MOUSE_INPUT_EVENT;
+	irrevent.MouseInput.Event = EMIE_MOUSE_WHEEL;
+	irrevent.MouseInput.Wheel = wheel;
+	irrevent.MouseInput.Gamepad = true;
+	irrevent.MouseInput.ButtonStates = MouseButtonStates;
+	irrevent.MouseInput.X = MouseX;
+	irrevent.MouseInput.Y = MouseY;
+	postEventFromUser(irrevent);
+}
+
 void CIrrDeviceSDL::postGamepadMouse(EMOUSE_INPUT_EVENT event, f32 wheel)
 {
 	SEvent irrevent{};
diff --git a/irr/src/CIrrDeviceSDL.h b/irr/src/CIrrDeviceSDL.h
index ac1286f40..b9369d0f1 100644
--- a/irr/src/CIrrDeviceSDL.h
+++ b/irr/src/CIrrDeviceSDL.h
@@ -318,6 +318,7 @@ class CIrrDeviceSDL : public CIrrDeviceStub
 	s16 GamepadAxes[static_cast<int>(GamepadAxis::COUNT)] = {};
 	u32 GamepadMouseButtons = 0; // pressed as the mouse, so their release goes the same way
 	u32 GamepadCursorTime = 0;
+	u32 GamepadWheelTime = 0; // the right stick's next scroll step
 	f32 GamepadCursorX = 0.0f, GamepadCursorY = 0.0f;
 	// the on-screen keyboard: a held D-pad direction repeats
 	GamepadButton KeyboardRepeatButton = GamepadButton::COUNT;
@@ -327,6 +328,7 @@ class CIrrDeviceSDL : public CIrrDeviceStub
 	void moveCursorWithGamepad();
 	void postGamepadClick(u32 button, bool down);
 	void postGamepadMouse(EMOUSE_INPUT_EVENT event, f32 wheel = 0.0f);
+	void postGamepadWheel(f32 wheel);
 	void postGamepadEscape(bool down);
 #endif // _IRR_COMPILE_WITH_JOYSTICK_EVENTS_
 
diff --git a/src/gui/guiFormSpecMenu.cpp b/src/gui/guiFormSpecMenu.cpp
index 37c124803..658d0c984 100644
--- a/src/gui/guiFormSpecMenu.cpp
+++ b/src/gui/guiFormSpecMenu.cpp
@@ -4495,6 +4495,18 @@ bool GUIFormSpecMenu::preprocessEvent(const SEvent& event)
 			}
 		}
 	}
+	// The gamepad's wheel scrolls what scrolls under the cursor, else the form's first scroll container,
+	// scrollbar or table: never an inventory list, where a wheel moves items
+	if (event.EventType == EET_MOUSE_INPUT_EVENT && event.MouseInput.Event == EMIE_MOUSE_WHEEL &&
+			event.MouseInput.Gamepad) {
+		if (gui::IGUIElement *target = gamepadScrollTarget(event.MouseInput.X, event.MouseInput.Y)) {
+			if (target->getType() == gui::EGUIET_SCROLL_BAR)
+				Environment->setFocus(target);
+			target->OnEvent(event);
+		}
+		return true;
+	}
+
 	// Mouse wheel and move events: send to hovered element instead of focused
 	if (event.EventType == EET_MOUSE_INPUT_EVENT &&
 			(event.MouseInput.Event == EMIE_MOUSE_WHEEL ||
@@ -4514,6 +4526,36 @@ bool GUIFormSpecMenu::preprocessEvent(const SEvent& event)
 	return false;
 }
 
+gui::IGUIElement *GUIFormSpecMenu::gamepadScrollTarget(s32 x, s32 y)
+{
+	const auto scrolls = [this](gui::IGUIElement *e) {
+		if (e->getType() == gui::EGUIET_SCROLL_BAR || e->getType() == gui::EGUIET_LIST_BOX ||
+				dynamic_cast<GUIHyperText *>(e))
+			return true;
+		for (const auto &container : m_scroll_containers)
+			if (container.second == e)
+				return true;
+		for (const auto &table : m_tables)
+			if (table.second == e)
+				return true;
+		return false;
+	};
+	gui::IGUIElement *e = Environment->getRootGUIElement()->getElementFromPoint(core::position2d<s32>(x, y));
+	for (; e && isMyDescendant(e); e = e->getParent())
+		if (scrolls(e) && e->isTrulyVisible())
+			return e;
+	for (const auto &container : m_scroll_containers)
+		if (container.second->isTrulyVisible())
+			return container.second;
+	for (const auto &scrollbar : m_scrollbars)
+		if (scrollbar.second->isTrulyVisible())
+			return scrollbar.second;
+	for (const auto &table : m_tables)
+		if (table.second->isTrulyVisible())
+			return table.second;
+	return nullptr;
+}
+
 void GUIFormSpecMenu::tryClose()
 {
 	if (m_allowclose) {
