From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Maicon Alves <alvesmaiconn@gmail.com>
Date: Tue, 13 Oct 2026 02:49:43 -0300
Subject: [PATCH 09/44] client: optionally unload blocks out of view, and touch
 blocks below 5 FPS

touchMapBlocks() keeps every block within the viewing range alive, all
around the player, and with a long range Client::step() raises
client_mapblock_limit to a sphere of 200 nodes (9202 blocks), so nothing
bounds the client's memory while moving. Walking 95 s through a forest at
range 320 on a 512 MB handheld, the client went from 306 to 1514 blocks,
~120 KB of RAM plus ~85 KB of GPU memory each, and free RAM from 432 to
36 MB.

client_unload_out_of_view (default false): touchMapBlocks() only keeps
alive the blocks within 3 mapblocks of the camera or inside the view cone
widened by 20 degrees; the rest expire after
client_unload_unused_data_timeout like blocks out of range, and the server
sends them again when they come back into view.

Also, game.cpp calls touchMapBlocks() only on a frame where the draw list
is not rebuilt, and the draw list is rebuilt whenever 0.2 s passed: below
5 FPS touchMapBlocks() never ran and every block, visible ones included,
expired after the timeout and was sent and meshed again. It now runs when
it is 8 s overdue.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>

diff --git a/builtin/settingtypes.txt b/builtin/settingtypes.txt
index 0e96ac09a..cdafe4ecc 100644
--- a/builtin/settingtypes.txt
+++ b/builtin/settingtypes.txt
@@ -2240,6 +2240,11 @@ max_out_chat_queue_size (Maximum size of the client's outgoing chat queue) [clie
 #    Timeout for client to remove unused map data from memory, in seconds.
 client_unload_unused_data_timeout (Mapblock unload timeout) [client] float 600.0 0.0
 
+#    Also unload, after the timeout above, blocks in range that are out of view:
+#    far behind or beside the camera. Saves memory while moving; turning back
+#    shows those blocks loading again.
+client_unload_out_of_view (Unload blocks out of view) [client] bool false
+
 #    Maximum number of mapblocks for client to be kept in memory.
 #    Note that there is an internal dynamic minimum number of blocks that
 #    won't be deleted, depending on the current view range.
diff --git a/src/client/clientmap.cpp b/src/client/clientmap.cpp
index 6622a1bd9..d8bd09194 100644
--- a/src/client/clientmap.cpp
+++ b/src/client/clientmap.cpp
@@ -154,6 +154,7 @@ static const std::string ClientMap_settings[] = {
 	"transparency_sorting_distance",
 	"occlusion_culler",
 	"enable_raytraced_culling",
+	"client_unload_out_of_view",
 };
 
 ClientMap::ClientMap(
@@ -201,6 +202,8 @@ void ClientMap::onSettingChanged(std::string_view name, bool all)
 		m_loops_occlusion_culler = g_settings->get("occlusion_culler") == "loops";
 	if (all || name == "enable_raytraced_culling")
 		m_enable_raytraced_culling = g_settings->getBool("enable_raytraced_culling");
+	if (all || name == "client_unload_out_of_view")
+		m_cache_unload_out_of_view = g_settings->getBool("client_unload_out_of_view");
 }
 
 ClientMap::~ClientMap()
@@ -768,6 +771,10 @@ void ClientMap::touchMapBlocks()
 	// Number of blocks in rendering range
 	u32 blocks_in_range = 0;
 
+	// client_unload_out_of_view: what is near or within the view cone plus a margin
+	const f32 keep_near = 3 * MAP_BLOCKSIZE * BS;
+	const f32 keep_half_angle = m_camera_fov / 2 + 20.0f * core::DEGTORAD;
+
 	for (const auto &sector_it : m_sectors) {
 		const MapSector *sector = sector_it.second;
 		v2s16 sp = sector->getPos();
@@ -808,9 +815,21 @@ void ClientMap::touchMapBlocks()
 					m_control.wanted_range * BS + mesh_sphere_radius)
 				continue; // Out of range, skip.
 
+			blocks_in_range++;
+
+			if (m_cache_unload_out_of_view) {
+				// Out of view: let it expire like a block out of range
+				v3f to_block = mesh_sphere_center - m_camera_position;
+				f32 dist = to_block.getLength();
+				f32 angle = keep_half_angle + std::asin(std::min(1.0f,
+						mesh_sphere_radius / std::max(dist, 1.0f)));
+				if (dist > keep_near && angle < core::PI &&
+						to_block.dotProduct(m_camera_direction) < dist * std::cos(angle))
+					continue;
+			}
+
 			// Keep the block alive as long as it is in range.
 			block->resetUsageTimer();
-			blocks_in_range++;
 		}
 	}
 
diff --git a/src/client/clientmap.h b/src/client/clientmap.h
index 0b8e3408e..9eb4b0c24 100644
--- a/src/client/clientmap.h
+++ b/src/client/clientmap.h
@@ -191,4 +191,5 @@ class ClientMap : public Map, public scene::ISceneNode
 
 	bool m_loops_occlusion_culler;
 	bool m_enable_raytraced_culling;
+	bool m_cache_unload_out_of_view;
 };
diff --git a/src/client/game.cpp b/src/client/game.cpp
index f9015562c..0682a0fb6 100644
--- a/src/client/game.cpp
+++ b/src/client/game.cpp
@@ -3542,7 +3542,11 @@ void Game::updateFrame(ProfilerGraph *graph, RunStats *stats, f32 dtime,
 
 	// call only one of updateDrawList, touchMapBlocks, or updateShadow per frame
 	// (the else-ifs below are intentional)
-	if (runData.update_draw_list_timer >= update_draw_list_delta
+	if (runData.touch_blocks_timer > 2 * touch_mapblock_delta) {
+		// Overdue: below 5 FPS the draw list is rebuilt every frame
+		client_map.touchMapBlocks();
+		runData.touch_blocks_timer = 0;
+	} else if (runData.update_draw_list_timer >= update_draw_list_delta
 			|| runData.update_draw_list_last_cam_dir.getDistanceFrom(camera_direction) > 0.2f
 			|| m_camera_offset_changed
 			|| client_map.needsUpdateDrawList()) {
diff --git a/src/defaultsettings.cpp b/src/defaultsettings.cpp
index d0e05623b..050fa3387 100644
--- a/src/defaultsettings.cpp
+++ b/src/defaultsettings.cpp
@@ -113,6 +113,7 @@ void set_default_settings()
 	settings->setDefault("screenshot_format", "png");
 	settings->setDefault("screenshot_quality", "0");
 	settings->setDefault("client_unload_unused_data_timeout", "600");
+	settings->setDefault("client_unload_out_of_view", "false");
 	settings->setDefault("client_mapblock_limit", "9300"); // about 145 MB
 	settings->setDefault("enable_build_where_you_stand", "false");
 	settings->setDefault("curl_timeout", "20000");
