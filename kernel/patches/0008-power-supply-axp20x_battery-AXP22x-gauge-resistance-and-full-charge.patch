From: alvesmaicon <alvesmaiconn@gmail.com>
Subject: [PATCH] power: supply: axp20x_battery: AXP22x gauge resistance and full charge

The AXP22x fuel gauge works out the open circuit voltage from the
battery voltage, the current and the battery's internal resistance
(0xba-0xbb), and corrects its coulomb count with it. The driver never
sets that resistance, so the gauge uses whatever the bootloader left
there. Write factory-internal-resistance-micro-ohms from the battery
node, as the BSP kernel does with its battery_rdc, unless the gauge
has measured one itself.

The coulomb count also doesn't follow the charger: a charge can end
with the battery at 4.2 V and the gauge still at 44%. On the charge
done IRQ, set the count (0xe2-0xe3) to the capacity (0xe0-0xe1), as
the BSP kernel does when the count goes past the capacity.

diff --git a/drivers/power/supply/axp20x_battery.c b/drivers/power/supply/axp20x_battery.c
--- a/drivers/power/supply/axp20x_battery.c
+++ b/drivers/power/supply/axp20x_battery.c
@@ -49,6 +49,10 @@
 
 #define AXP209_FG_PERCENT		GENMASK(6, 0)
 #define AXP22X_FG_VALID			BIT(7)
+#define AXP22X_FG_CAP_SET		BIT(7)
+#define AXP22X_RDC_SET			BIT(7)
+#define AXP22X_RDC_MEASURED		BIT(6)
+#define AXP22X_RDC_H_MASK		GENMASK(4, 0)
 
 #define AXP20X_CHRG_CTRL1_ENABLE	BIT(7)
 #define AXP20X_CHRG_CTRL1_TGT_VOLT	GENMASK(6, 5)
@@ -978,6 +982,45 @@ static void axp209_set_battery_info(struct platform_device *pdev,
 	}
 }
 
+static void axp22x_set_battery_info(struct platform_device *pdev,
+				    struct axp20x_batt_ps *axp_batt,
+				    struct power_supply_battery_info *info)
+{
+	int rdc = info->factory_internal_resistance_uohm;
+	unsigned int reg;
+
+	axp209_set_battery_info(pdev, axp_batt, info);
+
+	/* keep a resistance the gauge measured itself */
+	if (rdc <= 0 || regmap_read(axp_batt->regmap, AXP20X_RDC_H, &reg) ||
+	    (reg & AXP22X_RDC_MEASURED))
+		return;
+
+	rdc = DIV_ROUND_CLOSEST(rdc * 10, 10742);	/* 1.0742 mOhm a step */
+	regmap_write(axp_batt->regmap, AXP20X_RDC_H,
+		     AXP22X_RDC_SET | ((rdc >> 8) & AXP22X_RDC_H_MASK));
+	regmap_write(axp_batt->regmap, AXP20X_RDC_L, rdc & 0xff);
+}
+
+/* the gauge's count doesn't follow the charger to full: set it to the capacity */
+static irqreturn_t axp22x_battery_charge_done(int irq, void *devid)
+{
+	struct axp20x_batt_ps *axp_batt = devid;
+	unsigned int cap_h, cap_l;
+
+	if (!regmap_read(axp_batt->regmap, AXP288_FG_DES_CAP1_REG, &cap_h) &&
+	    !regmap_read(axp_batt->regmap, AXP288_FG_DES_CAP0_REG, &cap_l) &&
+	    (cap_h & AXP22X_FG_CAP_SET)) {
+		regmap_write(axp_batt->regmap, AXP288_FG_CC_MTR1_REG, cap_h);
+		regmap_write(axp_batt->regmap, AXP288_FG_CC_MTR0_REG, cap_l);
+		dev_info(axp_batt->dev, "charge done, gauge set to full\n");
+	}
+
+	power_supply_changed(axp_batt->batt);
+
+	return IRQ_HANDLED;
+}
+
 static void axp717_set_battery_info(struct platform_device *pdev,
 				    struct axp20x_batt_ps *axp_batt,
 				    struct power_supply_battery_info *info)
@@ -1044,7 +1087,7 @@ static const struct axp_data axp221_data = {
 	.get_max_voltage = axp22x_battery_get_max_voltage,
 	.set_max_voltage = axp22x_battery_set_max_voltage,
 	.cfg_iio_chan = axp209_bat_cfg_iio_channels,
-	.set_bat_info = axp209_set_battery_info,
+	.set_bat_info = axp22x_set_battery_info,
 };
 
 static const struct axp_data axp717_data = {
@@ -1095,7 +1138,7 @@ static int axp20x_power_probe(struct platform_device *pdev)
 	struct power_supply_config psy_cfg = {};
 	struct power_supply_battery_info *info;
 	struct device *dev = &pdev->dev;
-	int ret;
+	int irq, ret;
 
 	if (!of_device_is_available(pdev->dev.of_node))
 		return -ENODEV;
@@ -1139,6 +1182,19 @@ static int axp20x_power_probe(struct platform_device *pdev)
 	 */
 	axp20x_get_constant_charge_current(axp20x_batt, &axp20x_batt->max_ccc);
 
+	irq = platform_get_irq_byname_optional(pdev, "CHARG_DONE");
+	if (irq > 0) {
+		struct axp20x_dev *axp20x = dev_get_drvdata(pdev->dev.parent);
+
+		ret = devm_request_any_context_irq(dev,
+				regmap_irq_get_virq(axp20x->regmap_irqc, irq),
+				axp22x_battery_charge_done, 0,
+				"axp20x-battery", axp20x_batt);
+		if (ret < 0)
+			dev_err(dev, "couldn't request the charge done irq: %d\n",
+				ret);
+	}
+
 	return 0;
 }
 
