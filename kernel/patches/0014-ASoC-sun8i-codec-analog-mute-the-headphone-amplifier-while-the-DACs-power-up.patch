From: alvesmaicon <alvesmaiconn@gmail.com>
Subject: [PATCH] ASoC: sun8i-codec-analog: mute the headphone amplifier while the DACs power up

With the amplifier kept powered, every stream still starts with a click
on the headphones: the DACs powering up. The vendor driver mutes the
amplifier (HPPAMUTE) around that and ramps the volume up afterwards. On
the console, muting alone is enough, and 50 ms after the DACs are on
the click is over.

Clear the mute bits before the DACs power up, remembering what the user
had, and set them back 50 ms after the power-up sequence ends, from a
POST widget so the mixers are up too. A user who had the amplifier
muted keeps it muted.

diff --git a/sound/soc/sunxi/sun8i-codec-analog.c b/sound/soc/sunxi/sun8i-codec-analog.c
--- a/sound/soc/sunxi/sun8i-codec-analog.c
+++ b/sound/soc/sunxi/sun8i-codec-analog.c
@@ -216,7 +216,58 @@
 		       SUN8I_ADDA_ADC_AP_EN_ADCG, 0x7, 0,
 		       sun8i_codec_out_mixer_pregain_scale),
 };
+
+#define SUN8I_ADDA_HP_MUTE_MASK	(BIT(SUN8I_ADDA_DAC_PA_SRC_LHPPAMUTE) | \
+				 BIT(SUN8I_ADDA_DAC_PA_SRC_RHPPAMUTE))
+
+struct sun8i_codec_analog {
+	unsigned int hp_mute;	/* the user's HPPAMUTE bits, while hp_muted */
+	bool hp_muted;
+};
+
+/*
+ * The headphone amplifier plays the DACs powering up as a click. Mute it
+ * before they do, and give the user's mute back once the path is up.
+ */
+static int sun8i_dac_event(struct snd_soc_dapm_widget *w,
+			   struct snd_kcontrol *k, int event)
+{
+	struct snd_soc_component *component = snd_soc_dapm_to_component(w->dapm);
+	struct sun8i_codec_analog *priv = dev_get_drvdata(component->dev);
+	unsigned int val;
+
+	if (priv->hp_muted)
+		return 0;
+
+	val = snd_soc_component_read(component, SUN8I_ADDA_DAC_PA_SRC);
+	priv->hp_mute = val & SUN8I_ADDA_HP_MUTE_MASK;
+	if (!priv->hp_mute)
+		return 0;
+
+	snd_soc_component_update_bits(component, SUN8I_ADDA_DAC_PA_SRC,
+				      SUN8I_ADDA_HP_MUTE_MASK, 0);
+	priv->hp_muted = true;
+
+	return 0;
+}
+
+static int sun8i_hp_unmute_event(struct snd_soc_dapm_widget *w,
+				 struct snd_kcontrol *k, int event)
+{
+	struct snd_soc_component *component = snd_soc_dapm_to_component(w->dapm);
+	struct sun8i_codec_analog *priv = dev_get_drvdata(component->dev);
 
+	if (!priv->hp_muted)
+		return 0;
+
+	msleep(50);
+	snd_soc_component_update_bits(component, SUN8I_ADDA_DAC_PA_SRC,
+				      SUN8I_ADDA_HP_MUTE_MASK, priv->hp_mute);
+	priv->hp_muted = false;
+
+	return 0;
+}
+
 static const struct snd_soc_dapm_widget sun8i_codec_common_widgets[] = {
 	/* ADC */
 	SND_SOC_DAPM_ADC("Left ADC", NULL, SUN8I_ADDA_ADC_AP_EN,
@@ -225,10 +276,13 @@
 			 SUN8I_ADDA_ADC_AP_EN_ADCREN, 0),
 
 	/* DAC */
-	SND_SOC_DAPM_DAC("Left DAC", NULL, SUN8I_ADDA_DAC_PA_SRC,
-			 SUN8I_ADDA_DAC_PA_SRC_DACALEN, 0),
-	SND_SOC_DAPM_DAC("Right DAC", NULL, SUN8I_ADDA_DAC_PA_SRC,
-			 SUN8I_ADDA_DAC_PA_SRC_DACAREN, 0),
+	SND_SOC_DAPM_DAC_E("Left DAC", NULL, SUN8I_ADDA_DAC_PA_SRC,
+			   SUN8I_ADDA_DAC_PA_SRC_DACALEN, 0,
+			   sun8i_dac_event, SND_SOC_DAPM_PRE_PMU),
+	SND_SOC_DAPM_DAC_E("Right DAC", NULL, SUN8I_ADDA_DAC_PA_SRC,
+			   SUN8I_ADDA_DAC_PA_SRC_DACAREN, 0,
+			   sun8i_dac_event, SND_SOC_DAPM_PRE_PMU),
+	SND_SOC_DAPM_POST("HP Unmute", sun8i_hp_unmute_event),
 	/*
 	 * Due to this component and the codec belonging to separate DAPM
 	 * contexts, we need to manually link the above widgets to their
@@ -835,9 +889,15 @@
 
 static int sun8i_codec_analog_probe(struct platform_device *pdev)
 {
+	struct sun8i_codec_analog *priv;
 	struct regmap *regmap;
 	void __iomem *base;
 
+	priv = devm_kzalloc(&pdev->dev, sizeof(*priv), GFP_KERNEL);
+	if (!priv)
+		return -ENOMEM;
+	platform_set_drvdata(pdev, priv);
+
 	base = devm_platform_ioremap_resource(pdev, 0);
 	if (IS_ERR(base)) {
 		dev_err(&pdev->dev, "Failed to map the registers\n");
