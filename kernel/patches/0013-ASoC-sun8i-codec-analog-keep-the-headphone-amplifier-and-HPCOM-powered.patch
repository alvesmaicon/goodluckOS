From: alvesmaicon <alvesmaiconn@gmail.com>
Subject: [PATCH] ASoC: sun8i-codec-analog: keep the headphone amplifier and HPCOM powered

DAPM powers the headphone amplifier, HPCOM and its protection up for
every stream and down after it. Powering up sleeps 700 ms, which every
sound waits for, and the headphones hear the output ramp. Powering down
with headphones on the jack, their return on HPCOM, pops loudly and
resets the whole analog block to its defaults (headphone volume to 0,
the PA muted, every gain back to 0 dB).

The vendor driver never powers them down: HPPAEN is set once at probe,
HPCOM_FC and COMPTEN once at init, and a stream only mutes and ramps the
volume. Do the same: enable the amplifier when the headphone widgets
are added, leave its widget in the graph with no register, and force
HPCOM and its protection on. The speaker amplifier, the DAC and the
mixer still follow the streams.

Forcing the amplifier's widget on instead would stop DAPM there: a
widget whose power never changes doesn't mark its neighbours dirty, so
a speaker amplifier behind it keeps whatever state its last evaluation
left, off from boot or from the last toggle of the speaker switch
without a stream.

diff --git a/sound/soc/sunxi/sun8i-codec-analog.c b/sound/soc/sunxi/sun8i-codec-analog.c
--- a/sound/soc/sunxi/sun8i-codec-analog.c
+++ b/sound/soc/sunxi/sun8i-codec-analog.c
@@ -339,38 +339,11 @@
 	SOC_DAPM_ENUM("Headphone Source Playback Route",
 		      sun8i_codec_hp_src_enum),
 };
-
-static int sun8i_headphone_amp_event(struct snd_soc_dapm_widget *w,
-				     struct snd_kcontrol *k, int event)
-{
-	struct snd_soc_component *component = snd_soc_dapm_to_component(w->dapm);
-
-	if (SND_SOC_DAPM_EVENT_ON(event)) {
-		snd_soc_component_update_bits(component, SUN8I_ADDA_PAEN_HP_CTRL,
-					      BIT(SUN8I_ADDA_PAEN_HP_CTRL_HPPAEN),
-					      BIT(SUN8I_ADDA_PAEN_HP_CTRL_HPPAEN));
-		/*
-		 * Need a delay to have the amplifier up. 700ms seems the best
-		 * compromise between the time to let the amplifier up and the
-		 * time not to feel this delay while playing a sound.
-		 */
-		msleep(700);
-	} else if (SND_SOC_DAPM_EVENT_OFF(event)) {
-		snd_soc_component_update_bits(component, SUN8I_ADDA_PAEN_HP_CTRL,
-					      BIT(SUN8I_ADDA_PAEN_HP_CTRL_HPPAEN),
-					      0x0);
-	}
 
-	return 0;
-}
-
 static const struct snd_soc_dapm_widget sun8i_codec_headphone_widgets[] = {
 	SND_SOC_DAPM_MUX("Headphone Source Playback Route",
 			 SND_SOC_NOPM, 0, 0, sun8i_codec_hp_src),
-	SND_SOC_DAPM_OUT_DRV_E("Headphone Amp", SUN8I_ADDA_PAEN_HP_CTRL,
-			       SUN8I_ADDA_PAEN_HP_CTRL_HPPAEN, 0, NULL, 0,
-			       sun8i_headphone_amp_event,
-			       SND_SOC_DAPM_PRE_PMU | SND_SOC_DAPM_PRE_PMD),
+	SND_SOC_DAPM_OUT_DRV("Headphone Amp", SND_SOC_NOPM, 0, 0, NULL, 0),
 	SND_SOC_DAPM_SUPPLY("HPCOM Protection", SUN8I_ADDA_PAEN_HP_CTRL,
 			    SUN8I_ADDA_PAEN_HP_CTRL_COMPTEN, 0, NULL, 0),
 	SND_SOC_DAPM_REG(snd_soc_dapm_supply, "HPCOM", SUN8I_ADDA_PAEN_HP_CTRL,
@@ -415,6 +388,22 @@
 		dev_err(dev, "Failed to add Headphone DAPM routes: %d\n", ret);
 		return ret;
 	}
+
+	/*
+	 * Powering the amplifier up takes 700 ms and is heard on the
+	 * headphones, and powering it down with the jack's return on HPCOM
+	 * pops and resets the analog block to its defaults. The vendor
+	 * driver never powers it down: enable it here, once, and keep HPCOM
+	 * and its protection on. Its widget stays in the graph with no
+	 * register: forced on instead, it would never change power, and
+	 * DAPM would stop marking the widgets behind it (a speaker
+	 * amplifier) dirty, leaving them as they were.
+	 */
+	snd_soc_component_update_bits(cmpnt, SUN8I_ADDA_PAEN_HP_CTRL,
+				      BIT(SUN8I_ADDA_PAEN_HP_CTRL_HPPAEN),
+				      BIT(SUN8I_ADDA_PAEN_HP_CTRL_HPPAEN));
+	snd_soc_dapm_force_enable_pin(dapm, "HPCOM");
+	snd_soc_dapm_force_enable_pin(dapm, "HPCOM Protection");
 
 	return 0;
 }
