From: alvesmaicon <alvesmaiconn@gmail.com>
Subject: [PATCH] drm/panel: nv3051d: a vendor init table per panel, and the R36H's

The NV3051D panels of the R36S family differ from unit to unit in their
init sequence, which the vendor kernels keep in the device tree as a
table: data type, delay in ms, length, then the bytes. Let a panel give
such a table instead of the driver's built-in sequence, and add the
R36H's (its stock device tree, 640x480 at 60 Hz) without the last sleep
out and display on, which prepare() sends.

--- a/drivers/gpu/drm/panel/panel-newvision-nv3051d.c
+++ b/drivers/gpu/drm/panel/panel-newvision-nv3051d.c
@@ -29,6 +29,8 @@
 	u16 width_mm, height_mm;
 	u32 bus_flags;
 	u32 mode_flags;
+	const u8 *init_seq;
+	unsigned int init_len;
 };
 
 struct panel_nv3051d {
@@ -42,12 +44,33 @@
 static inline struct panel_nv3051d *panel_to_panelnv3051d(struct drm_panel *panel)
 {
 	return container_of(panel, struct panel_nv3051d, panel);
+}
+
+/* Vendor format: data type, delay after it in ms, length, then the bytes */
+static int panel_nv3051d_init_table(struct panel_nv3051d *ctx)
+{
+	struct mipi_dsi_device *dsi = to_mipi_dsi_device(ctx->dev);
+	struct mipi_dsi_multi_context dsi_ctx = {.dsi = dsi};
+	const u8 *p = ctx->panel_info->init_seq;
+	const u8 *end = p + ctx->panel_info->init_len;
+
+	while (p + 3 <= end && p + 3 + p[2] <= end) {
+		mipi_dsi_dcs_write_buffer_multi(&dsi_ctx, p + 3, p[2]);
+		if (p[1])
+			mipi_dsi_msleep(&dsi_ctx, p[1]);
+		p += 3 + p[2];
+	}
+
+	return dsi_ctx.accum_err;
 }
 
 static int panel_nv3051d_init_sequence(struct panel_nv3051d *ctx)
 {
 	struct mipi_dsi_device *dsi = to_mipi_dsi_device(ctx->dev);
 	struct mipi_dsi_multi_context dsi_ctx = {.dsi = dsi};
+
+	if (ctx->panel_info->init_seq)
+		return panel_nv3051d_init_table(ctx);
 
 	/*
 	 * Init sequence was supplied by device vendor with no
@@ -483,9 +506,193 @@
 		.vtotal         = 480 + 18 + 2 + 4,
 		.clock          = 24150,
 		.flags          = DRM_MODE_FLAG_NHSYNC | DRM_MODE_FLAG_NVSYNC,
