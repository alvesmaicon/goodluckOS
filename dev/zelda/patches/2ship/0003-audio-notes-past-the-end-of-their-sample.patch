 namespace SOH {
+// MM plays a loop with count 2 on to sampleEnd once its note is released. The archive doesn't carry it, and left
+// unset it was whatever the heap held: derive it from the sample's length.
+static uint32_t SampleEnd(const SOH::Sample& sample) {
+    switch (sample.codec) {
+        case CODEC_ADPCM:
+            return sample.size / 9 * 16;
+        case CODEC_SMALL_ADPCM:
+            return sample.size / 5 * 16;
+        case CODEC_S8:
+            return sample.size;
+        default:
+            return sample.size / 2;
+    }
+}
