+#ifdef USE_GLES2
+// GLES2 has no glBlitFramebuffer: copy by drawing the source texture as a quad
+void GfxRenderingAPIOGL::DrawTextureToFramebuffer(GLuint tex, int texW, int texH, int srcX0, int srcY0, int srcX1,
+                                                  int srcY1, const FramebufferOGL& dst, int dstX0, int dstY0,
+                                                  int dstX1, int dstY1) {
+    if (mBlitProgram == 0) {
+        static const char* vs = "#version 100\n"
+                                "attribute vec2 aPos;\n"
+                                "attribute vec2 aUv;\n"
+                                "varying vec2 vUv;\n"
+                                "void main() { vUv = aUv; gl_Position = vec4(aPos, 0.0, 1.0); }\n";
+        static const char* fs = "#version 100\n"
+                                "precision mediump float;\n"
+                                "uniform sampler2D uTex;\n"
+                                "varying vec2 vUv;\n"
+                                "void main() { gl_FragColor = texture2D(uTex, vUv); }\n";
+        GLuint v = glCreateShader(GL_VERTEX_SHADER);
+        glShaderSource(v, 1, &vs, nullptr);
+        glCompileShader(v);
+        GLuint f = glCreateShader(GL_FRAGMENT_SHADER);
+        glShaderSource(f, 1, &fs, nullptr);
+        glCompileShader(f);
+        mBlitProgram = glCreateProgram();
+        glAttachShader(mBlitProgram, v);
+        glAttachShader(mBlitProgram, f);
+        glLinkProgram(mBlitProgram);
+        glDeleteShader(v);
+        glDeleteShader(f);
+        mBlitPosLocation = glGetAttribLocation(mBlitProgram, "aPos");
+        mBlitUvLocation = glGetAttribLocation(mBlitProgram, "aUv");
+    }
+
+    const float u0 = (float)srcX0 / texW, u1 = (float)srcX1 / texW;
+    const float v0 = (float)srcY0 / texH, v1 = (float)srcY1 / texH;
+    const float x0 = 2.0f * dstX0 / dst.width - 1.0f, x1 = 2.0f * dstX1 / dst.width - 1.0f;
+    const float y0 = 2.0f * dstY0 / dst.height - 1.0f, y1 = 2.0f * dstY1 / dst.height - 1.0f;
+    const float quad[] = { x0, y0, u0, v0, x1, y0, u1, v0, x0, y1, u0, v1, x1, y1, u1, v1 };
+
+    GLint viewport[4];
+    glGetIntegerv(GL_VIEWPORT, viewport);
+    const GLboolean depthTest = glIsEnabled(GL_DEPTH_TEST);
+    const GLboolean blend = glIsEnabled(GL_BLEND);
+    const GLboolean polygonOffset = glIsEnabled(GL_POLYGON_OFFSET_FILL);
+    ShaderProgram* prg = mLastLoadedShader;
+    UnloadShader(prg);
+
+    glBindFramebuffer(GL_FRAMEBUFFER, dst.fbo);
+    glViewport(0, 0, dst.width, dst.height);
+    glDisable(GL_DEPTH_TEST);
+    glDisable(GL_BLEND);
+    glDisable(GL_POLYGON_OFFSET_FILL);
+    glActiveTexture(GL_TEXTURE0);
+    glBindTexture(GL_TEXTURE_2D, tex);
+    glUseProgram(mBlitProgram);
+    glBufferData(GL_ARRAY_BUFFER, sizeof(quad), quad, GL_STREAM_DRAW);
+    glEnableVertexAttribArray(mBlitPosLocation);
+    glVertexAttribPointer(mBlitPosLocation, 2, GL_FLOAT, GL_FALSE, 4 * sizeof(float), (void*)0);
+    glEnableVertexAttribArray(mBlitUvLocation);
+    glVertexAttribPointer(mBlitUvLocation, 2, GL_FLOAT, GL_FALSE, 4 * sizeof(float), (void*)(2 * sizeof(float)));
+    glDrawArrays(GL_TRIANGLE_STRIP, 0, 4);
+    glDisableVertexAttribArray(mBlitPosLocation);
+    glDisableVertexAttribArray(mBlitUvLocation);
+
+    glBindTexture(GL_TEXTURE_2D, mLastBoundTextures[0]);
+    mLastActiveTexture = 0;
+    glViewport(viewport[0], viewport[1], viewport[2], viewport[3]);
+    if (depthTest) {
+        glEnable(GL_DEPTH_TEST);
+    }
+    if (blend) {
+        glEnable(GL_BLEND);
+    }
+    if (polygonOffset) {
+        glEnable(GL_POLYGON_OFFSET_FILL);
+    }
+    if (prg != nullptr) {
+        LoadShader(prg);
+    } else {
+        glUseProgram(0);
+    }
+}
